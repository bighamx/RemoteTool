+def _purge_empty_admitted_session(record, job):
+    """Delete this fire's admitted session row if the run left it completely empty.
+
+    Monitor/wake-gated fires short-circuit before any agent machinery runs, but the owner's
+    admission has already created the session row, so every suppressed tick of a 5-minute poller
+    used to pile up untitled empty sessions. Runs that produced anything (messages, title, a
+    continuation) are refused by ``delete_session_if_empty`` itself. Must run AFTER the fire is
+    terminal: the owner holds the row's turn lease until then, and a lease-guarded row is simply
+    not deleted.
+    """
+    try:
+        receipt = record.get('receipt') or {}
+        sid = receipt.get('session_id')
+        if not sid:
+            return
+        from hermes_constants import get_hermes_home
+        from hermes_state import SessionDB
+        db = SessionDB(get_hermes_home() / 'state.db')
+        try:
+            if db.delete_session_if_empty(sid):
+                logging.getLogger('cron.scheduler').debug(
+                    "Job '%s': purged empty admitted cron session %s", job['id'], sid)
+        finally:
+            with contextlib.suppress(Exception):
+                db.close()
+    except Exception:  # noqa: BLE001 — housekeeping must never fail the fire
+        pass
+
