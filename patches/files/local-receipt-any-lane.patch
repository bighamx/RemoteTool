--- a/gateway/session_route_recovery.py
+++ b/gateway/session_route_recovery.py
@@ -39,6 +39,21 @@ def _messaging_platform(label):
     return None if platform in (Platform.LOCAL, Platform.API_SERVER) else platform
 
 
+def _lane_left_local(route):
+    """True when *route* names a lane other than LOCAL — every takeover that strands a local receipt.
+
+    ``_messaging_platform`` answers a narrower question (is this a messaging platform) and so misses
+    the lanes that rewrite a row's identity without being one: the API transport (``api_server``) and
+    labels no ``Platform`` answers to (``desktop``). Their takeover makes the local receipt just as
+    unusable as ``/handoff`` does — ``session_local_recovery._checked_entry`` compares the row's
+    ``session_key`` with the receipt's route, so every open, pin and rename refuses ``stored identity
+    mismatch`` while the receipt sits there forever (#143286 covers only the messaging half).
+    Unparseable keys and LOCAL's own keys never qualify: their conversation is still local."""
+    from gateway.run import _parse_session_key
+    platform = (_parse_session_key(route) or {}).get('platform')
+    return isinstance(platform, str) and platform != Platform.LOCAL.value
+
+
