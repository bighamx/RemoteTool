@{ Layout = "_Layout"; }
@section Styles { <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/phone-tools.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/web-api.js" asp-append-version="true"></script><script src="~/js/phone-tools.js" asp-append-version="true"></script> }
<div id="phone-tools-app" class="workspace-page phone-tools-page" v-cloak>
    <header class="workspace-heading"><div><h1>手机工具</h1><p>查看已连接的 Android 手机，为 Agent 配置工具连接。</p></div><i-button :loading="loading" :disabled="busy" @@click="refresh">刷新</i-button></header>
    <p v-if="error" class="workspace-alert" role="alert">{{error}}</p>
    <p v-if="notice" role="status">{{notice}}</p>
    <section class="workspace-panel"><div class="panel-tools"><strong>在线手机 · {{devices.length}}</strong></div>
        <p v-if="!loading &amp;&amp; !devices.length" class="empty-state">暂无在线手机。请在 Android 的“手机工具”中启用服务，并连接当前 RemoteTool 通道。</p>
        <article v-for="phone in devices" :key="phone.id" class="data-row"><div class="row-main"><h3>{{phone.name || phone.id}}</h3><small>{{phone.id}} · 在线</small></div><div class="row-actions"><i-button :disabled="busy" @@click="showTools(phone)">可用工具</i-button><i-button type="primary" :disabled="busy||uncertain" @@click="openCreate(phone)">创建 MCP 连接</i-button></div></article>
    </section>
    <section class="workspace-panel"><div class="panel-tools"><strong>外部 Agent 连接 · {{connections.length}}</strong></div><p v-if="!connections.length" class="empty-state">暂无外部连接。聊天会话的手机工具在新建会话时单独选择。</p>
        <article v-for="connection in connections" :key="connection.id" class="data-row"><div class="row-main"><h3>{{phoneName(connection.phone_id)}}</h3><small>{{connection.online?'手机在线':'手机离线'}} · {{connection.allow_advanced?'允许高级操作':'基础工具'}} · {{time(connection.created)}}</small><code>{{connection.id}}</code></div><div class="row-actions"><i-button :disabled="busy" @@click="revoke(connection)">撤销连接</i-button></div></article>
    </section>
    <modal v-model="createOpen" title="创建手机 MCP 连接" :closable="!busy" :mask-closable="!busy" :footer-hide="true" width="520"><div class="phone-tools-form"><p>{{selectedPhone?.name}} · 为外部 Agent 生成独立连接。</p><label><input type="checkbox" v-model="advanced" :disabled="busy">允许高级操作</label><p class="agent-create-hint">默认只开放基础工具。高级操作仍取决于手机已开启的能力和系统授权。</p><p v-if="error" role="alert">{{error}}</p><p v-if="uncertain" role="alert">上次创建结果未确认，请先刷新连接列表核对，勿直接重试。</p><i-button type="primary" :loading="busy" :disabled="uncertain" @@click="createConnection">创建连接</i-button></div></modal>
    <modal v-model="toolsOpen" title="手机可用工具" :footer-hide="true" width="620"><p>{{selectedPhone?.name}} · 基础工具</p><p v-if="toolsLoading" role="status">正在读取…</p><p v-if="toolsError" role="alert">{{toolsError}}</p><p v-if="!toolsLoading &amp;&amp; !toolsError &amp;&amp; !tools.length">手机尚未提供工具。</p><article v-for="tool in tools" :key="tool.name" class="phone-tool-description"><strong>{{tool.title || tool.name}}</strong><code>{{tool.name}}</code><p>{{tool.description}}</p></article></modal>
    <modal v-model="credentialsOpen" title="MCP 连接配置" :footer-hide="true" width="620" @@on-visible-change="credentialsVisibility"><div class="phone-tools-form"><p>令牌只在本次创建后显示，不写入浏览器存储。关闭后可从连接列表撤销。</p><label>MCP 配置<textarea readonly aria-label="手机 MCP 配置" :value="connectionConfig" rows="10"></textarea></label><i-button @@click="copyConfig">复制配置</i-button></div></modal>
</div>
