<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#10151d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="RemoteTool">
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/mobile/icon-192.png" />
    <title>@ViewBag.Title · RemoteTool</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/helper/lib/viewuiplus.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <script src="~/helper/lib/vue.global.prod.js" asp-append-version="true"></script>
    <script src="~/helper/lib/viewuiplus.min.js" asp-append-version="true"></script>
</head>
<body data-build="@DateTime.UtcNow.Ticks">
    <div class="app-shell">
        <aside class="app-sidebar" id="app-sidebar" aria-label="主导航">
            <a class="app-brand" href="/"><span class="app-brand-mark">R</span><span><strong>RemoteTool</strong><small>工作台</small></span></a>
            <nav class="side-nav" id="shell-nav" v-cloak>
                <template v-for="group in groups" :key="group.title">
                    <p class="side-nav-label">{{group.title}}</p>
                    <a v-for="item in group.items" :key="item.key" :data-nav="item.key" :href="item.href"><img v-if="item.image" class="nav-icon-image" :src="item.icon" alt=""><span v-else class="nav-icon-mark" :style="{maskImage:'url('+item.icon+')',WebkitMaskImage:'url('+item.icon+')'}" aria-hidden="true"></span> {{item.label}}</a>
                </template>
            </nav>
            <div class="sidebar-footer"><span class="sidebar-online-dot"></span><div class="sidebar-device"><span>当前设备 · <strong title="@Environment.MachineName">@Environment.MachineName</strong></span><small class="sidebar-version">服务端 @RemoteTool.WebApi.Services.ServerBuild.Version</small></div></div>
        </aside>
        <div class="app-workspace">
            <header class="app-topbar">
                <div class="topbar-leading">
                    <button id="sidebar-toggle" class="topbar-icon-button" type="button" aria-label="打开导航" aria-controls="app-sidebar" aria-expanded="false">☰</button>
                    <div class="topbar-title"><small>REMOTE TOOL / 工作台</small><strong id="workspace-topbar-title" data-default="@ViewBag.Title" v-cloak>{{currentTitle}}</strong></div>
                </div>
                <div class="header-right">
                    <button id="install-app-btn" class="btn btn-secondary btn-sm" type="button" aria-label="安装应用" title="安装应用" hidden>安装</button>
                    <button id="theme-toggle" class="btn btn-secondary btn-sm" title="切换主题">☀️</button>
                    <span id="user-info"></span>
                    <button id="logout-btn" class="btn btn-secondary btn-sm">退出</button>
                </div>
            </header>
            @RenderSection("Tabs", required: false)
            <main class="main-content" id="main-content">@RenderBody()</main>
        </div>
    </div>
    <div id="sidebar-scrim" class="sidebar-scrim" hidden></div>
    @RenderSection("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/workspace-router.js" asp-append-version="true"></script>
</body>
</html>
