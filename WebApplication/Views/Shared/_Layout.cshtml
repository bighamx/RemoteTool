<!DOCTYPE html>
<html lang="zh-CN" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, interactive-widget=resizes-content">
    <meta name="theme-color" content="#10151d">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="RemoteTool">
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/mobile/icon-192.png" />
    <title>@ViewBag.Title · RemoteTool</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/helper/lib/viewuiplus.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/server-update.css" asp-append-version="true" />
    <script src="~/helper/lib/vue.global.prod.js" asp-append-version="true"></script>
    <script src="~/helper/lib/viewuiplus.min.js" asp-append-version="true"></script>
</head>
<body data-build="@DateTime.UtcNow.Ticks">
    <div class="app-shell">
        <aside class="app-sidebar" id="app-sidebar" aria-label="主导航">
            <a class="app-brand" href="/"><span class="app-brand-mark">R</span><span><strong>RemoteTool</strong><small>工作台</small></span></a>
            <nav class="side-nav" id="shell-nav" v-cloak>
                <template v-for="group in groups" :key="group.title">
                    <p class="side-nav-label">{{group.title}}</p>
                    <a v-for="item in group.items" :key="item.key" :data-nav="item.key" :href="item.href"><img v-if="item.image" class="nav-icon-image" :src="item.icon" alt=""><span v-else class="nav-icon-mark" :style="{maskImage:'url('+item.icon+')',WebkitMaskImage:'url('+item.icon+')'}" aria-hidden="true"></span> {{item.label}}</a>
                </template>
            </nav>
            <div class="sidebar-footer"><span class="sidebar-online-dot"></span><div class="sidebar-device"><span>当前设备 · <strong title="@Environment.MachineName">@Environment.MachineName</strong></span><small class="sidebar-version"><span>服务端 @RemoteTool.WebApi.Services.ServerBuild.DisplayVersion</span><button class="sidebar-update-button" data-server-update-entry type="button" title="有可用更新，查看服务端更新" aria-label="查看可用的服务端更新" hidden>更新</button></small></div></div>
        </aside>
        <div class="app-workspace">
            <header class="app-topbar">
                <div class="topbar-leading">
                    <button id="sidebar-toggle" class="topbar-icon-button" type="button" aria-label="打开导航" aria-controls="app-sidebar" aria-expanded="false">☰</button>
                    <div class="topbar-title"><small>REMOTE TOOL / 工作台</small><strong id="workspace-topbar-title" data-default="@ViewBag.Title" v-cloak>{{currentTitle}}</strong></div>
                </div>
                <div class="header-right">
                    <button id="install-app-btn" class="btn btn-secondary btn-sm" type="button" aria-label="安装应用" title="安装应用" hidden>安装</button>
                    <button id="theme-toggle" class="btn btn-secondary btn-sm" title="切换主题">☀️</button>
                    <span id="user-info"></span>
                    <button id="logout-btn" class="btn btn-secondary btn-sm">退出</button>
                </div>
            </header>
            @RenderSection("Tabs", required: false)
            <main class="main-content" id="main-content">@RenderBody()</main>
        </div>
    </div>
    <nav class="mobile-navigation" aria-label="手机主导航">
        <a href="/#/system" data-mobile-nav="system"><img src="/icons/speed.svg" alt=""><span>系统</span></a>
        <a href="/#/desktop" data-mobile-nav="desktop"><img src="/icons/desktop_windows.svg" alt=""><span>远程</span></a>
        <a href="/#/codex" data-mobile-nav="codex"><img src="/icons/codex.png" alt=""><span>Codex</span></a>
        <a href="/#/hermes" data-mobile-nav="hermes"><img src="/icons/hermes.svg" alt=""><span>Hermes</span></a>
        <button type="button" data-mobile-nav="more" aria-haspopup="dialog" aria-controls="mobile-tools"><svg class="mobile-more-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><circle cx="6" cy="12" r="1.5" fill="currentColor"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/><circle cx="18" cy="12" r="1.5" fill="currentColor"/></svg><span>更多</span></button>
    </nav>
    <dialog id="mobile-tools" class="mobile-tools" aria-labelledby="mobile-tools-title">
        <header><div><small>当前设备 · @Environment.MachineName</small><h2 id="mobile-tools-title">更多功能</h2></div><button type="button" data-close-tools aria-label="关闭更多功能">×</button></header>
        <div class="mobile-tools-list">
            <a href="/#/"><img src="/icons/home.svg" alt=""><span><strong>设备概览</strong><small>常用功能与任务概况</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/storage"><img src="/icons/folder.svg" alt=""><span><strong>空间管理</strong><small>存储占用与清理</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/files"><img src="/icons/folder.svg" alt=""><span><strong>文件管理</strong><small>浏览、上传与下载</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/terminal"><img src="/icons/terminal.svg" alt=""><span><strong>命令终端</strong><small>交互式 Shell</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/docker"><img src="/icons/layers.svg" alt=""><span><strong>Docker</strong><small>容器、镜像与 Compose</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/cloudflare"><img src="/icons/layers.svg" alt=""><span><strong>Cloudflare</strong><small>DNS、R2、D1 与隧道</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/jobs"><img src="/icons/schedule.svg" alt=""><span><strong>定时任务</strong><small>计划、队列与日志</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/processes"><img src="/icons/memory.svg" alt=""><span><strong>进程管理</strong><small>资源占用与进程操作</small></span><span aria-hidden="true">›</span></a>
            <a href="/#/identity"><img src="/icons/shield.svg" alt=""><span><strong>身份验证</strong><small>OIDC 与 Cloudflare Access</small></span><span aria-hidden="true">›</span></a>
            <button type="button" data-mobile-action="reload"><span aria-hidden="true">↻</span><span><strong>重新加载界面</strong><small>加载最新版本</small></span></button>
            <button type="button" data-mobile-action="keyboard"><span aria-hidden="true">⌨</span><span><strong>键盘诊断</strong><small>keyboard-unreported-4 · 仅记录窗口尺寸</small></span></button>
            <button type="button" data-mobile-action="theme"><span aria-hidden="true">◐</span><span><strong>切换深浅主题</strong></span></button>
            <button type="button" data-mobile-action="logout"><span aria-hidden="true">↪</span><span><strong>退出登录</strong></span></button>
        </div>
    </dialog>
    <dialog id="keyboard-diagnostics" class="mobile-tools" aria-labelledby="keyboard-diagnostics-title">
        <header><h2 id="keyboard-diagnostics-title">键盘诊断</h2><button type="button" data-close-keyboard aria-label="关闭键盘诊断">×</button></header>
        <div class="keyboard-diagnostics-body"><p>先在聊天框呼出键盘，再打开此页。记录不包含消息、账号或凭据。</p><textarea id="keyboard-diagnostics-text" readonly aria-label="键盘诊断记录"></textarea><button type="button" data-copy-keyboard>复制诊断</button></div>
    </dialog>
    <div id="sidebar-scrim" class="sidebar-scrim" hidden></div>
    @RenderSection("Scripts", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/server-update.js" asp-append-version="true"></script>
    <script src="~/js/workspace-router.js" asp-append-version="true"></script>
</body>
</html>
