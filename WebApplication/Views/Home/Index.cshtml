@{
    ViewData["Title"] = "总览";
    Layout = "_Layout";
}
@section Styles { <link href="~/css/workspace-pages.css" rel="stylesheet" asp-append-version="true" /><link href="~/css/index.css" rel="stylesheet" asp-append-version="true" /> }
@section Scripts { <script src="~/js/web-api.js" asp-append-version="true"></script><script src="~/js/index.js" asp-append-version="true"></script> }
<div id="overview-app" class="workspace-page overview-page" v-cloak>
    <div class="workspace-heading"><div><p class="eyebrow">REMOTE TOOL / OVERVIEW</p><h1>设备工作台</h1><p>系统管理、自动化任务与智能体会话集中在左侧导航。</p></div><i-button icon="md-refresh" :loading="loading" @@click="refresh">刷新概览</i-button></div>
    <div class="overview-metrics"><div class="metric-card"><span>运行中任务</span><strong>{{stats.processing ?? '—'}}</strong></div><div class="metric-card"><span>待执行任务</span><strong>{{stats.enqueued ?? '—'}}</strong></div><div class="metric-card"><span>失败任务</span><strong>{{stats.failed ?? '—'}}</strong></div><div class="metric-card"><span>计划任务</span><strong>{{recurringCount}}</strong></div></div>
    <p v-if="error" class="workspace-alert">{{error}}</p>
    <div class="overview-section-label">常用功能</div>
    <div class="overview-grid"><a v-for="item in shortcuts" :key="item.href" :href="item.href" class="overview-shortcut"><span class="shortcut-icon"><span class="shortcut-glyph" :style="{maskImage:'url('+item.icon+')',WebkitMaskImage:'url('+item.icon+')'}"></span></span><strong>{{item.title}}</strong><small>{{item.description}}</small><span class="shortcut-arrow">→</span></a></div>
    <footer class="version-footer">服务端 @ViewBag.BuildInfo</footer>
</div>
