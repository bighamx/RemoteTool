@{
    Layout = "_Layout";
    ViewBag.Title = "定时任务";
}
@section Styles { <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" /> }
@section Scripts {
    <script src="~/js/web-api.js" asp-append-version="true"></script>
    <script src="~/js/jobs-page.js" asp-append-version="true"></script>
}
<div id="jobs-app" class="workspace-page" v-cloak>
    <div class="workspace-heading">
        <div><p class="eyebrow">AUTOMATION / HANGFIRE</p><h1>定时任务</h1><p>查看计划、执行状态与日志，并直接管理任务。</p></div>
        <i-button icon="md-refresh" :loading="loading" @@click="refresh">刷新</i-button>
    </div>
    <div v-if="error" class="workspace-alert" role="alert">{{error}} <i-button size="small" @@click="refresh">重试</i-button></div>
    <div class="metric-row">
        <button v-for="metric in metrics" :key="metric.key" class="metric-card" type="button" @@click="selectTab(metric.key)"><span>{{metric.label}}</span><strong>{{stat(metric.key)}}</strong></button>
    </div>
    <div class="workspace-panel">
        <div class="pill-tabs" role="tablist" aria-label="任务状态">
            <i-button v-for="item in tabs" :key="item.key" :type="tab===item.key?'primary':'default'" :ghost="tab===item.key" size="small" @@click="selectTab(item.key)">{{item.label}}</i-button>
        </div>
        <div class="panel-tools">
            <span>{{tabs.find(item=>item.key===tab)?.label}}</span>
            <i-input v-if="tab==='enqueued'" v-model="queue" placeholder="队列名" style="width:180px" @@on-enter="refresh"></i-input>
        </div>
        <div v-if="tab==='recurring'" class="data-list">
            <article class="data-row" v-for="job in recurring" :key="job.id">
                <div class="row-main"><strong>{{job.id}}</strong><small>{{job.cron}} · {{job.timeZoneId}}</small><small>下次执行 {{time(job.nextExecution)}} · 最近状态 {{job.lastJobState || '尚未执行'}}</small><small v-if="job.error" class="danger-text">{{job.error}}</small></div>
                <div class="row-actions"><i-button size="small" @@click="showDetail(job.lastJobId)" :disabled="!job.lastJobId">日志</i-button><i-button size="small" @@click="trigger(job.id)">立即执行</i-button><i-button size="small" @@click="editRecurring(job)">修改计划</i-button><i-button size="small" type="error" ghost @@click="removeRecurring(job.id)">删除</i-button></div>
            </article>
            <div class="empty-state" v-if="!recurring.length && !loading">暂无定时任务</div>
        </div>
        <div v-else-if="tab==='servers'" class="data-list">
            <article class="data-row" v-for="(server,index) in servers" :key="index"><div class="row-main"><strong>{{server.name || server.Name || '服务 ' + (index+1)}}</strong><small>{{jsonSummary(server)}}</small></div></article>
            <article class="data-row" v-for="(item,index) in queues" :key="'q'+index"><div class="row-main"><strong>队列 {{item.name || item.Name}}</strong><small>等待 {{item.length ?? item.Length ?? 0}} · 已获取 {{item.fetched ?? item.Fetched ?? 0}}</small></div></article>
        </div>
        <div v-else class="data-list">
            <article class="data-row" v-for="job in jobs" :key="job.id"><div class="row-main"><strong>#{{job.id}}</strong><small>{{job.type}}.{{job.method}}</small></div><div class="row-actions"><i-button size="small" @@click="showDetail(job.id)">详情 / 日志</i-button><i-button size="small" @@click="retry(job.id)">重试</i-button><i-button size="small" type="error" ghost @@click="removeJob(job.id)">删除</i-button></div></article>
            <div class="empty-state" v-if="!jobs.length && !loading">此状态下暂无任务</div>
            <div class="list-pager"><i-button size="small" :disabled="offset===0" @@click="page(-1)">上一页</i-button><span>第 {{offset/30+1}} 页</span><i-button size="small" :disabled="jobs.length<30" @@click="page(1)">下一页</i-button></div>
        </div>
    </div>
    <div v-if="detail" class="workspace-modal-backdrop" @@click.self="detail=null"><div class="workspace-modal" role="dialog" aria-modal="true" aria-label="任务详情"><div class="workspace-modal-head"><h2>任务 #{{detail.id}}</h2><i-button size="small" @@click="detail=null">关闭</i-button></div><div class="workspace-modal-body"><p><strong>{{detail.type}}.{{detail.method}}</strong> · {{detail.state}}</p><p>创建 {{time(detail.createdAt)}} · 队列 {{detail.queue || 'default'}}</p><h3>参数</h3><pre>{{format(detail.parameters)}}</pre><h3>执行历史</h3><div v-for="(item,index) in detail.history" :key="index" class="history-row">{{time(item.createdAt)}} · {{item.stateName}} · {{item.reason || ''}}</div><h3>控制台日志</h3><pre class="console-log">{{consoleText || '暂无日志'}}</pre><i-button size="small" :disabled="!consoleHasMore" @@click="loadConsole">加载更多日志</i-button></div></div></div>
</div>
