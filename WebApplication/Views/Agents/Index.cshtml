        <div class="inspector-section"><h4>模型设置</h4><select v-model="modelSelection.provider" @@change="providerChanged"><option value="">默认提供方</option><option v-for="item in providerChoices" :key="item.id" :value="item.id">{{item.name}}</option></select><input v-model="modelSelection.model" :list="'agent-models-'+agent" aria-label="模型" placeholder="搜索或输入模型"><datalist :id="'agent-models-'+agent"><option v-for="item in modelChoices" :key="item.id" :value="item.id">{{item.name}}</option></datalist><p v-if="selectedProviderMetadata.models_warning" class="agent-inline-error">{{selectedProviderMetadata.models_warning}}</p><p v-if="modelDefaults.aggregate" class="agent-create-hint">聚合目录 · 保留模型的完整标识以确保路由正确</p><p v-if="modelsError" class="agent-inline-error">{{modelsError}}</p><i-button size="small" @@click="loadModels(true)">刷新模型列表</i-button><select v-model="modelSelection.effort" aria-label="推理强度"><option value="">默认推理强度</option><option v-for="effort in effortChoices" :key="effort" :value="effort">{{effort}}</option></select><select v-if="agent==='codex'" v-model="modelSelection.tier" aria-label="服务等级"><option value="">默认速度</option><option v-if="!tierChoices.includes('default')" value="default">标准速度</option><option v-if="modelSelection.tier && modelSelection.tier!=='default' && !tierChoices.includes(modelSelection.tier)" :value="modelSelection.tier">当前速度 · {{modelSelection.tier}}</option><option v-for="tier in tierChoices" :key="tier" :value="tier">{{tier==='default'?'标准速度':tier==='fast'?'快速':tier}}</option></select><p v-if="agent==='hermes' && !modelSessionSupported">当前 Hermes 版本仅支持全局默认模型，请在 Hermes 管理中设置。</p><i-button size="small" long :disabled="agent==='hermes' && !modelSessionSupported" @@click="saveModel">应用到会话</i-button></div>
        <div class="inspector-section" v-if="agent==='claude'"><h4>账户额度</h4><template v-if="claudeUsage?.available"><p v-for="group in quotaGroups(claudeUsage)" :key="group.name"><span v-for="w in group.windows" :key="w.label">{{w.label}} · {{w.remaining==null?'暂无数据':'剩余 '+w.remaining+'%'}}<template v-if="w.resetsAt"> · {{time(w.resetsAt)}} 重置</template><br></span></p></template><p v-else>{{claudeUsage?.message || '正在读取额度…'}}</p><p v-if="claudeUsage?.available &amp;&amp; claudeUsage?.message" class="agent-create-hint">{{claudeUsage.message}}</p><p class="agent-create-hint">{{claudeUsage?.source || '官方 Claude Code 订阅额度'}}</p></div>
        <div class="inspector-section" v-if="agent==='codex'"><h4>消息队列</h4><div v-if="queue.length" v-for="item in queue" :key="item.id" class="queue-row"><span>{{queueText(item)}}</span><i-button size="small" type="text" @@click="removeQueued(item)">删除</i-button></div><p v-else>队列为空</p></div>
        <div class="inspector-section" v-if="agent==='codex'"><h4>Codex 账户</h4><p v-if="accounts.current_identity">{{accounts.current_identity.email || accounts.current_identity.name || accounts.current}}</p><select v-model="selectedAccount" aria-label="Codex 账户"><option v-for="item in accounts.data || []" :key="item.id" :value="item.id">{{item.name || item.email || item.id}}</option></select><i-button size="small" long :disabled="!selectedAccount || selectedAccount===accounts.current" @@click="useAccount">切换账户</i-button></div>
        <div class="inspector-section"><h4>操作</h4><i-button size="small" long @@click="showActiveTools()">工具调用详情</i-button><i-button size="small" long @@click="showFiles">查看附件</i-button></div>
    </aside>
    <teleport to="body">
        <div v-if="messageMenu || sessionMenu" class="agent-context-backdrop" @@click.self="closeContextMenu">
            <div ref="contextMenu" class="agent-context-menu" :style="{left:(sessionMenu||messageMenu).x+'px',top:(sessionMenu||messageMenu).y+'px'}" role="dialog" aria-modal="true" :aria-label="sessionMenu?'会话操作':'消息操作'" @@click.stop>
                <div class="agent-context-head"><strong>{{sessionMenu?'会话操作':'消息操作'}}</strong><button ref="contextMenuClose" type="button" aria-label="关闭操作菜单" @@click="closeContextMenu">关闭</button></div>
                <div class="agent-context-items" role="menu" :aria-label="sessionMenu?'会话操作':'消息操作'">
                    <template v-if="messageMenu"><button type="button" role="menuitem" @@click="runContextMenuAction('copyMessage',messageMenu.message)">复制消息</button><button v-if="messageMenu.message.id && ['user','assistant'].includes(messageMenu.message.role)" type="button" role="menuitem" @@click="runContextMenuAction('forkMessage',messageMenu.message)">从这里分叉</button><button v-if="messageMenu.message.role==='user' && messageMenu.message.id && messageMenu.message.editable!==false" type="button" role="menuitem" :disabled="!canEditMessage(messageMenu.message)" :title="editBlockedReason()" @@click="runContextMenuAction('editMessage',messageMenu.message)">{{externalRunning?'其他客户端执行中':activeRun?'当前任务执行中':'撤回并编辑'}}</button></template>
                    <template v-if="sessionMenu"><button type="button" role="menuitem" @@click="runContextMenuAction('select',sessionMenu.session)">打开会话</button><button type="button" role="menuitem" @@click="runContextMenuAction('showSessionDetails',sessionMenu.session)">会话详情</button><button type="button" role="menuitem" @@click="runContextMenuAction('copySessionId',sessionMenu.session)">复制会话 ID</button><button type="button" role="menuitem" @@click="runContextMenuAction('renameSession',sessionMenu.session)">重命名</button><button type="button" role="menuitem" @@click="runContextMenuAction('togglePin',sessionMenu.session)">{{sessionMenu.session.pinned?'取消置顶':'置顶会话'}}</button><button type="button" role="menuitem" @@click="runContextMenuAction('refreshSessions')">刷新列表</button><button v-if="agent==='codex'" type="button" role="menuitem" @@click="runContextMenuAction('openMoveDialog',sessionMenu.session)">移动到项目</button><button v-if="agent==='codex'" type="button" role="menuitem" @@click="runContextMenuAction('toggleArchiveSession',sessionMenu.session)">{{sessionMenu.session.archived?'取消存档':'存档会话'}}</button><button type="button" role="menuitem" class="danger" @@click="runContextMenuAction('deleteSession',sessionMenu.session)">删除会话</button></template>
                </div>
            </div>
        </div>
    </teleport>
