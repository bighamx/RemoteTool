                <label class="agent-field agent-field-wide"><span>新密钥（留空保留原值）</span><input type="password" v-model="adminProvider.api_key" autocomplete="new-password" :disabled="adminBusy" /></label>
            </div>
            <div class="agent-admin-dialog-actions">
                <i-button :disabled="adminBusy" @@click="adminProviderDialog=false">取消</i-button>
                <i-button type="primary" :disabled="adminBusy || !adminProvider.name || !adminProvider.base_url" @@click="saveAdminProvider">保存提供方</i-button>
            </div>
        </div>
    </modal>
    <modal :model-value="!!sessionDetails" @@on-cancel="sessionDetails=null" title="会话详情" :footer-hide="true" width="620">
        <div v-if="sessionDetails" class="agent-session-detail">
            <div class="agent-session-detail-actions"><i-button size="small" @@click="copySessionId(sessionDetails.session)">复制会话 ID</i-button><i-button size="small" :loading="sessionDetails.loading" @@click="showSessionDetails(sessionDetails.session)">刷新</i-button></div>
            <p v-if="sessionDetails.loading">读取中…</p><p v-if="sessionDetails.error" class="agent-inline-error">{{sessionDetails.error}}</p>
            <section v-for="section in sessionDetails.sections" :key="section.title"><h4>{{section.title}}</h4><dl><template v-for="field in section.fields" :key="field[0]"><dt>{{field[0]}}</dt><dd>{{field[1]}}</dd></template></dl></section>
        </div>
    </modal>
    <modal v-model="setupDetails" title="安装与配置" :footer-hide="true" width="560"><div class="agent-create-form"><p>{{agentSetup?.installationNote}}</p><ol><li v-for="step in agentSetup?.steps || []" :key="step">{{step}}</li></ol><i-button @@click="setupDetails=false">知道了</i-button></div></modal>
    <modal v-model="showPermissionsDialog" title="当前会话权限" :mask-closable="!permissionsSaving" :closable="!permissionsSaving" :footer-hide="true" width="520">
        <div class="agent-create-form">
            <p v-if="permissionsLoading">正在读取权限…</p>
            <p v-if="permissionsLoaded">{{permissionsInfo}}</p>
            <template v-if="agent==='claude'"><label v-for="choice in permissionsChoices" :key="choice.id" class="agent-create-root"><input type="radio" v-model="permissionsChoice" :value="choice.id" :disabled="!permissionsLoaded || permissionsSaving" /><span><strong>{{choice.label}}</strong><br><small>{{choice.description}}</small></span></label>
            <p class="agent-create-hint">Claude Code 的 allow/deny 规则仍由本机设置决定；任务执行中修改会立即作用于当前任务。</p>
            <p v-if="permissionsError" class="agent-create-error">{{permissionsError}}</p>
            <div class="agent-create-actions"><i-button :disabled="permissionsSaving" @@click="showPermissionsDialog=false">取消</i-button><i-button type="primary" :loading="permissionsSaving" :disabled="!permissionsLoaded || permissionsChoice===permissionsMode" @@click="savePermissions">保存</i-button></div></template>
            <template v-else>
            <p v-if="permissionsLoaded">下一轮 RemoteTool 权限设置：{{permissionsMode==='full'?'完全访问 · 不再审批':permissionsMode==='workspace'?'工作区访问 · 按需审批':'未覆盖，沿用 Codex 原有策略'}}</p>
            <label><input type="radio" v-model="permissionsChoice" value="workspace" :disabled="!permissionsLoaded || permissionsSaving" /> 工作区访问 · 按需审批</label>
            <label><input type="radio" v-model="permissionsChoice" value="full" :disabled="!permissionsLoaded || permissionsSaving" /> 完全访问 · 不再审批</label>
            <p>完全访问允许联网、执行命令及读写工作区外文件，并跳过审批。</p>
            <p class="agent-create-hint">仅设置当前会话，从下一轮通过 RemoteTool 发送的消息开始生效；不会解除当前轮正在等待的审批。</p>
            <p v-if="permissionsError" class="agent-create-error">{{permissionsError}}</p>
            <div class="agent-create-actions"><i-button :disabled="permissionsSaving" @@click="showPermissionsDialog=false">取消</i-button><i-button type="primary" :loading="permissionsSaving" :disabled="!permissionsLoaded || !['workspace','full'].includes(permissionsChoice)" @@click="savePermissions">保存</i-button></div>
            </template>
        </div>
    </modal>
    <modal v-model="showMoveDialog" title="移动到项目" :footer-hide="true" width="480">
        <div class="agent-create-form">
            <p v-if="moveTarget" class="agent-create-hint">会话「{{moveTarget.title || '未命名会话'}}」当前归属：{{moveTarget.group_name || '无项目'}}</p>
            <i-input v-model="moveSearch" search placeholder="搜索项目" clearable></i-input>
            <div class="agent-create-projects">
                <button type="button" class="agent-create-project" :class="{active: moveTarget && !moveTarget.project_id}" :disabled="moveMoving || (moveTarget && !moveTarget.project_id)" @@click="doMove('')"><strong>无项目</strong><span v-if="moveTarget && !moveTarget.project_id">当前归属</span></button>
                <button type="button" v-for="project in filteredMoveProjects" :key="project.id" class="agent-create-project" :class="{active: moveTarget && moveTarget.project_id === project.id}" :disabled="moveMoving || (moveTarget && moveTarget.project_id === project.id)" @@click="doMove(project.id)"><strong>{{project.name}}</strong><span v-for="root in projectRootsOf(project)" :key="root">{{root}}</span><span v-if="moveTarget && moveTarget.project_id === project.id">当前归属</span></button>
                <p v-if="!filteredMoveProjects.length" class="agent-create-hint">没有匹配项目</p>
            </div>
            <p v-if="moveError" class="agent-create-error">{{moveError}}</p>
            <div class="agent-create-actions"><i-button @@click="showMoveDialog=false">取消</i-button></div>
        </div>
    </modal>
    <modal v-model="showWorkspaceDialog" title="Codex 工作空间与用量" :mask-closable="!switchingWorkspace" :closable="!switchingWorkspace" :footer-hide="true" width="640">
        <div class="agent-workspace-quotas">
            <p>{{officialProviderInUse?'当前使用官方账户':'当前使用三方 Provider：'+currentWorkspaceName}}</p>
            <div class="agent-quota-toolbar"><span>5 小时与周额度均显示剩余比例</span><i-button size="small" :loading="workspaceLoading" :disabled="!!switchingWorkspace" @@click="refreshWorkspaces(true)">刷新用量</i-button></div>
            <p v-if="workspaceError" class="agent-inline-error" role="alert">{{workspaceError}}</p>
            <p v-if="workspaceLoading && !(workspaces.data || []).length">正在读取工作空间…</p>
            <p v-if="!workspaceLoading && !workspaceError && !(workspaces.data || []).length">暂无已保存的工作空间，请先在 App 或桌面登录。</p>
            <section v-for="row in workspaces.data || []" :key="row.id" class="agent-workspace-quota" :class="{current:officialProviderInUse && row.id===workspaces.current}">
                <div class="agent-workspace-quota-content"><header><div><strong>{{workspaceName(row)}}</strong><small>{{row.email}} · {{row.plan_type || '官方账户'}}</small></div><span v-if="officialProviderInUse && row.id===workspaces.current">当前工作空间</span></header>
                <template v-if="workspaceUsages[row.id]?.available"><div v-for="group in quotaGroups(workspaceUsages[row.id].usage)" :key="group.name" class="agent-quota-group"><small>{{group.name}}</small><div class="agent-quota-windows"><div v-for="window in group.windows" :key="window.label"><div>{{window.label}} · {{window.remaining==null?'暂无数据':'剩余 '+window.remaining+'%'}}</div><i-progress v-if="window.remaining!=null" :percent="window.remaining" :status="window.remaining<20?'wrong':'normal'" :stroke-width="4" hide-info></i-progress><small v-if="window.resetsAt">重置：{{time(window.resetsAt)}}</small></div></div></div><p v-if="!quotaGroups(workspaceUsages[row.id].usage).length">暂无额度窗口数据</p></template>
                <p v-else>{{workspaceUsages[row.id]?.error || (workspaceLoading?'正在读取用量…':'暂无用量数据')}}</p>
                </div><i-button v-if="!officialProviderInUse || row.id!==workspaces.current" class="agent-workspace-switch" size="large" :loading="switchingWorkspace===row.id" :disabled="!!switchingWorkspace || !!activeRun || externalRunning || sending || !!pending" @@click="useWorkspace(row)">切换</i-button>
            </section>
            <section class="inspector-section">
                <h4>三方 Provider</h4><p>切换默认提供方会重启电脑 Codex。已有会话保留自己的模型设置。</p>
                <div v-for="row in thirdPartyProviders" :key="row.id" class="agent-workspace-quota"><div><strong>{{row.name||row.id}} {{row.current?'· 当前使用':''}}</strong><p>{{providerAuthText(row)}}</p></div><i-button size="small" :disabled="!!switchingWorkspace || row.compatibility==='cc_switch_managed_proxy'" @@click="editCodexProvider(row)">编辑</i-button></div>
                <label>提供方<select v-model="providerSwitch.provider" @@change="chooseSwitchProvider" :disabled="!!switchingWorkspace"><option value="">选择提供方</option><option v-for="row in thirdPartyProviders" :key="row.id" :value="row.id" :disabled="row.compatibility==='cc_switch_managed_proxy'">{{row.name||row.id}}</option></select></label>
                <label>模型<input v-model="providerSwitch.model" list="codex-switch-models" placeholder="搜索或输入模型" :disabled="!!switchingWorkspace"></label><datalist id="codex-switch-models"><option v-for="m in switchProviderMetadata.models||[]" :key="m.model||m.id||m" :value="m.model||m.id||m">{{m.displayName||m.name||m.model||m}}</option></datalist>
                <p v-if="switchProviderMetadata.models_warning" class="agent-inline-error">{{switchProviderMetadata.models_warning}}</p>
                <i-button :disabled="!!switchingWorkspace || !providerSwitch.provider || !providerSwitch.model.trim()" @@click="switchProvider">切换提供方</i-button>
                <i-button :disabled="!!switchingWorkspace" @@click="editCodexProvider()">新增提供方</i-button>
                <form v-if="codexProviderEdit" class="agent-create-form" v-on:submit.prevent="saveCodexProvider">
                    <label>名称<input v-model="codexProviderEdit.name" required :disabled="!!switchingWorkspace"></label>
                    <label>Responses API 地址<input v-model="codexProviderEdit.base_url" type="url" required :disabled="!!switchingWorkspace"></label>
                    <label>默认模型<input v-model="codexProviderEdit.model" required :disabled="!!switchingWorkspace"></label>
                    <label>API Key（留空保留）<input v-model="codexProviderEdit.api_key" type="password" autocomplete="new-password" :disabled="!!switchingWorkspace"></label>
                    <div><button type="submit" class="ivu-btn ivu-btn-primary" :disabled="!!switchingWorkspace">保存提供方</button><i-button :disabled="!!switchingWorkspace" @@click="codexProviderEdit=null">取消</i-button></div>
                </form>
            </section>
        </div>
    </modal>
    <modal v-model="showCreateDialog" :title="'新建 '+agentName+' 会话'" :mask-closable="!creating" :footer-hide="true" width="560">
        <div class="agent-create-form"><label for="agent-create-title">会话名称</label><i-input v-model="createTitle" id="agent-create-title" placeholder="为会话命名" @@on-enter="newSession"></i-input>
            <template v-if="agent==='claude'"><label for="agent-create-cwd">工作目录 · 会话将在此目录执行，并加载其中的 CLAUDE.md 与项目设置</label>
                <div class="agent-create-browse"><i-input v-model="createRoot" id="agent-create-cwd" placeholder="/path/to/project 或 C:\project" :disabled="creating"></i-input><i-button size="small" :disabled="creating" @@click="openCreateBrowser">浏览</i-button></div>
                <label for="agent-create-permission">权限模式</label><select id="agent-create-permission" v-model="createPermission" :disabled="creating"><option value="default">按本机规则询问</option><option value="acceptEdits">自动批准文件编辑</option><option value="plan">计划模式</option></select>
                <p class="agent-create-hint">使用服务端用户已登录的官方 Claude Code 与其中的 hooks、skills、MCP 配置；不提供绕过权限模式。</p></template>
            <template v-if="agent==='codex'"><label>工作项目</label>
                <div class="agent-create-modes"><button type="button" v-for="m in [['existing','已有项目'],['new','新项目'],['none','无项目']]" :key="m[0]" class="agent-create-mode" :class="{active:createMode===m[0]}" @@click="createMode=m[0]" :disabled="creating">{{m[1]}}</button></div>
                <template v-if="createMode==='existing'"><i-input v-model="createProjectSearch" placeholder="搜索电脑上的项目" :disabled="creating"></i-input>
                    <div class="agent-create-projects"><button type="button" v-for="project in filteredCreateProjects" :key="project.id" class="agent-create-project" :class="{active:createProjectId===project.id}" @@click="pickCreateProject(project)" :disabled="creating"><strong>{{project.name}}</strong><span v-for="root in projectRootsOf(project)" :key="root">{{root}}</span></button>
                        <p v-if="!filteredCreateProjects.length" class="agent-create-hint">没有匹配项目，可切换“新项目”或“无项目”。</p></div>
                    <template v-if="createProjectRoots.length"><label>工作目录 · 会话将在此目录中执行</label>
                        <label v-for="root in createProjectRoots" :key="root" class="agent-create-root"><input type="radio" :value="root" v-model="createRoot" :disabled="creating"><span>{{root}}</span></label></template>
                </template>
                <template v-else-if="createMode==='new'"><label for="agent-create-project-name">项目名称</label><i-input v-model="createProjectName" id="agent-create-project-name" placeholder="项目名称" :disabled="creating"></i-input>
                    <label>项目文件夹 · 单选指定默认工作目录（最多 16 个）</label>
                    <label v-for="path in createRoots" :key="path" class="agent-create-root"><input type="radio" :value="path" v-model="createRoot" :disabled="creating"><span>{{path}}</span><button type="button" class="agent-create-root-remove" @@click="toggleCreateRoot(path)" :disabled="creating" aria-label="移除文件夹">×</button></label>
                    <p v-if="!createRoots.length" class="agent-create-hint">还没有文件夹，点下方“浏览电脑目录”添加。</p>
                    <div class="agent-create-browse"><i-button size="small" :disabled="creating||createRoots.length>=16" @@click="openCreateBrowser">浏览电脑目录</i-button><span class="agent-create-hint">可选择多个现有目录，也可在浏览器中新建文件夹。</span></div></template>
                <template v-else><p class="agent-create-hint">独立会话，不归入项目。使用独立工作目录保存本次会话的文件。</p></template>
            </template>
            <p v-if="createError" class="agent-create-error">{{createError}}</p>
            <div class="agent-create-actions"><i-button @@click="showCreateDialog=false" :disabled="creating">取消</i-button><i-button type="primary" :loading="creating" :disabled="!createValid" @@click="newSession">创建会话</i-button></div></div>
    </modal>
    <modal v-model="createBrowser" title="选择项目工作目录" :footer-hide="true" width="560">
        <div class="agent-create-browser"><div class="agent-create-browser-path"><code>{{createBrowserPath || '此电脑'}}</code><i-button size="small" :disabled="!createBrowserPath||createBrowserLoading" @@click="createBrowserUp">上级</i-button></div>
            <div class="agent-create-browser-list"><button type="button" v-for="dir in createBrowserDirs" :key="dir.path" class="agent-create-browser-item" @@click="enterCreateBrowser(dir)" :disabled="createBrowserLoading"><span class="agent-create-browser-icon" aria-hidden="true"></span><span>{{dir.name}}</span></button>
                <p v-if="createBrowserLoading" class="agent-create-hint">读取中…</p><p v-else-if="!createBrowserDirs.length" class="agent-create-hint">没有子目录。</p></div>
            <p v-if="createBrowserError" class="agent-create-error">{{createBrowserError}}</p>
            <div class="agent-create-browser-new"><i-input v-model="createBrowserNew" placeholder="新文件夹名称" :disabled="!createBrowserPath||createBrowserMkdir"></i-input><i-button size="small" :disabled="!createBrowserNew.trim()||!createBrowserPath||createBrowserMkdir" :loading="createBrowserMkdir" @@click="mkdirInCreateBrowser">新建</i-button></div>
            <div class="agent-create-actions"><i-button @@click="createBrowser=false">取消</i-button><i-button type="primary" :disabled="!createBrowserPath" @@click="useCreateBrowserDir">使用此目录</i-button></div></div>
    </modal>
    <modal v-model="showEditDialog" title="撤回并编辑消息" :mask-closable="!editing" :footer-hide="true" width="560"><div class="agent-create-form"><p>确认后会回退这条消息之后的内容，再发送编辑后的消息。</p><label for="agent-edit-text">消息内容</label><textarea id="agent-edit-text" v-model="editText" rows="7"></textarea><div v-if="editFiles.length" class="agent-attachment-drafts"><span v-for="(file,index) in editFiles" :key="file.id">{{file.name}} <button type="button" @@click="editFiles.splice(index,1)">×</button></span></div><label class="agent-upload-label"><input type="file" multiple @@change="uploadEditFiles" :disabled="editing"><span class="agent-upload-icon" aria-hidden="true"></span><span>添加附件</span></label><p v-if="editError" class="agent-create-error">{{editError}}</p><div class="agent-create-actions"><i-button @@click="showEditDialog=false" :disabled="editing">取消</i-button><i-button type="primary" :loading="editing" :disabled="!editText.trim() || !canEditMessage(editTarget)" @@click="submitEdit">撤回并重发</i-button></div></div></modal>
    <modal v-model="showSchedule" title="定时发送" :mask-closable="!scheduleBusy" :footer-hide="true" width="520"><div class="agent-create-form"><label for="agent-schedule-text">消息内容</label><textarea id="agent-schedule-text" v-model="scheduleText" rows="4" :disabled="scheduleBusy||!!scheduleRequest"></textarea><label for="agent-schedule-at">发送时间</label><input id="agent-schedule-at" type="datetime-local" v-model="scheduleAt" :disabled="scheduleBusy||!!scheduleRequest"><div class="agent-schedule-quick"><i-button size="small" @@click="quickSchedule(60)" :disabled="scheduleBusy||!!scheduleRequest">1 小时后</i-button><i-button size="small" @@click="quickSchedule(0,9,1)" :disabled="scheduleBusy||!!scheduleRequest">明天 9:00</i-button></div><p class="agent-create-hint">由服务端到点发送，关闭网页或手机也会执行；会话忙时排队等当前任务结束。</p><p v-if="scheduleError" class="agent-create-error">{{scheduleError}}</p><div class="agent-create-actions"><i-button @@click="showSchedule=false" :disabled="scheduleBusy">取消</i-button><i-button type="primary" :loading="scheduleBusy" :disabled="!scheduleText.trim()||!scheduleAt" @@click="createSchedule">确定</i-button></div></div></modal>
    <div v-if="dialog" class="workspace-modal-backdrop" @@click.self="dialog=null"><div class="workspace-modal" role="dialog" aria-modal="true"><div class="workspace-modal-head"><h2>{{dialog.title}}</h2><i-button size="small" @@click="dialog=null">关闭</i-button></div><div class="workspace-modal-body"><pre v-if="dialog.text">{{dialog.text}}</pre><div v-for="tool in dialog.tools" :key="tool.id" class="agent-tool-detail"><div><strong>{{tool.tool || '工具'}}</strong><span class="tool-state" :class="tool.status">{{tool.status || '运行中'}}</span></div><pre>{{tool.description || tool.preview || '暂无参数详情'}}</pre></div><div v-for="file in dialog.files" :key="file.id" class="history-row"><i-button type="text" :title="canPreviewFile(file)?'预览文件':'下载文件'" @@click="canPreviewFile(file)?openFile(file):downloadFile(file)">{{file.name || file.id}}</i-button> · {{file.size || 0}} B</div><i-button v-if="dialog.more" size="small" @@click="loadMoreTool">加载更多</i-button></div></div></div>
</div>
