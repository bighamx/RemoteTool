@{
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agent-workspace.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/web-api.js" asp-append-version="true"></script>
    <script src="~/js/web-sse.js" asp-append-version="true"></script>
    @if (ViewBag.Agent == "codex" || ViewBag.Agent == "claude") {
        <script src="~/vendor/markdown-it/markdown-it.min.js" asp-append-version="true"></script>
    }
    <script src="~/js/agent-history-cache.js" asp-append-version="true"></script>
    <script src="~/js/agent-workspace.js" asp-append-version="true"></script>
}
<div id="agent-app" class="agent-workspace" :class="{'admin-active':adminOpen}" data-agent="@ViewBag.Agent" v-cloak>
    <div v-if="sessionsOpen" class="agent-sessions-backdrop" @@click="sessionsOpen=false"></div>
    <aside class="agent-sessions" :class="{'mobile-open':sessionsOpen}">
        <div class="agent-pane-head"><div class="agent-pane-identity"><span class="agent-brand-icon"><img :src="agentIcon" :alt="agentName"></span><div><small>会话列表</small><h2>{{agentName}}</h2></div></div><i-button v-if="agent==='codex'" size="small" :icon="groupByProject?'md-list':'md-folder'" :title="groupByProject?'按最近会话显示':'按项目分组'" @@click="toggleGroupMode"></i-button><span class="agent-pane-tools"><i-button size="small" icon="md-refresh" title="刷新会话列表" aria-label="刷新会话列表" :loading="loadingList" @@click="refreshSessions"></i-button><details v-if="agent==='hermes'" class="agent-session-actions agent-pane-menu"><summary aria-label="Hermes 全局管理">⋮</summary><div><button type="button" @@click="openHermesAdmin">Hermes 管理</button><button type="button" @@click="refreshSessions()">刷新列表</button></div></details><i-button type="primary" size="small" icon="md-add" title="新建会话" aria-label="新建会话" @@click="openCreateDialog"></i-button></span><button class="agent-sessions-close" type="button" @@click="closeSessionList" aria-label="收起会话列表">×</button></div>
        <div v-if="agent==='hermes'" class="agent-profile-row">
            <span>Profile</span>
            <select :value="profile" aria-label="切换 Profile" :disabled="sending || uploading" @@focus="loadProfiles" @@change="switchProfile($event.target.value)">
                <option v-if="!profiles.some(row=>row.id===profile)" :value="profile">{{profile}}</option>
                <option v-for="row in profiles" :key="row.id" :value="row.id" :disabled="!row.available">{{row.name}}{{row.reason?' · '+row.reason:''}}</option>
            </select>
        </div>
        <small v-if="agent==='hermes' && profileError" class="agent-profile-error">{{profileError}}</small>
        <div class="agent-search"><i-input v-model="search" search placeholder="搜索会话名称、目录或 ID" clearable></i-input></div>
        <div v-if="listError" class="agent-inline-error">{{readableAgentError(listError)}} <i-button size="small" @@click="refreshSessions">重试</i-button></div>
        <div class="agent-session-list">
            <template v-for="group in displayedGroups" :key="group.key"><button v-if="groupByProject && agent==='codex' && group.name" type="button" class="agent-session-group" @@click="toggleGroup(group.name)"><span>{{group.name}}</span><span class="agent-session-group-count">{{group.rows.length}}</span><span class="agent-session-group-caret">{{collapsedGroups.includes(group.name)?'▸':'▾'}}</span></button><div v-for="item in groupRows(group)" :key="item.id" class="agent-session-row"><button type="button" class="agent-session-item" :class="{active:item.id===selectedId}" @@click="select(item)" @@contextmenu.prevent="openSessionMenu($event,item)"><span class="agent-session-heading"><span class="agent-session-title"><span v-if="item.pinned" title="置顶">◆</span>{{item.title || '未命名会话'}}<Icon v-if="item.archived" type="md-archive" title="已存档" class="agent-session-archived"></Icon></span><span v-if="sessionRunning(item)" class="agent-session-running">运行中</span></span><span class="agent-session-preview">{{item.preview || item.latest_user_message || item.cwd || '打开会话'}}</span><span class="agent-session-foot"><span class="agent-session-location">{{item.cwd || (agentName+' 会话')}}</span><span class="agent-session-time">{{time(item.last_active || item.started_at)}}</span></span><span v-if="contextPct(item)>0" class="agent-session-contextbar" :title="contextBarTitle(item)"><i :style="{width: contextPct(item)+'%'}" :class="{hot: contextPct(item)>=85}"></i></span></button><button type="button" class="mobile-session-menu mobile-only" :aria-label="'会话操作：'+(item.title||'未命名会话')" @@click.stop="openSessionMenu($event,item)">⋮</button></div></template>
            <div v-if="!filteredSessions.length && !loadingList" class="agent-list-empty">暂无会话</div>
            <i-button v-if="hasMore" long size="small" :loading="loadingList" @@click="moreSessions">加载更多</i-button>
        </div>
    </aside>
    <section class="agent-conversation">
        <div class="agent-conversation-head">
            <div class="agent-conversation-title"><span class="agent-conversation-icon"><img :src="agentIcon" :alt="agentName"></span><div><h2>{{selected?.title || agentName}}</h2><button v-if="agent==='codex'" type="button" class="agent-quota-summary" @@click="openWorkspaceDialog" :title="usageError || '查看工作空间用量和切换工作空间'"><span>{{quotaWorkspaceName}}</span><span class="agent-header-quota-windows"><span v-for="window in headerQuotaWindows" :key="window.minutes" class="agent-header-quota-window"><span>{{window.label}} · {{usageLoading?'读取中…':window.remaining==null?'暂无数据':'剩余 '+window.remaining+'%'}}</span><span v-if="window.remaining!=null" class="agent-header-quota-track" :class="{low:window.remaining<20}"><span :style="{width:window.remaining+'%'}"></span></span></span></span></button><small>{{selected?.cwd || statusText}}</small></div></div>
            <div class="agent-head-trailing"><button type="button" class="mobile-finish-input" @@click="$refs.composer?.blur();$event.currentTarget.blur()">完成</button><button class="agent-mobile-sessions" type="button" @@click="openSessionList" :aria-expanded="sessionsOpen" aria-label="显示会话列表"><svg viewBox="0 0 24 24" width="23" height="23" aria-hidden="true"><path d="M4 4h16v12H8l-4 4V4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></button><button type="button" class="mobile-new-session mobile-only" aria-label="新建会话" @@click="openCreateDialog">＋</button><span class="agent-status-pill"><span></span>{{statusText}}</span><details class="agent-session-actions"><summary aria-label="会话操作" title="会话操作">⋮</summary><div><button type="button" :disabled="!selectedId" @@click="showSessionDetails()">会话详情</button><button type="button" :disabled="!selectedId" @@click="copySessionId()">复制会话 ID</button><button v-if="agent!=='hermes'" type="button" :disabled="!selectedId" @@click="openPermissions">会话权限</button><button v-if="agent==='codex'" type="button" @@click="openProviderManagement">Provider 管理</button><button v-if="agent==='hermes'" type="button" @@click="showFiles">查看附件</button><button v-if="agent==='hermes'" type="button" @@click="inspectorOpen=true">当前会话模型</button><button v-if="agent==='hermes'" type="button" @@click="openHermesAdmin">Hermes 管理 ↗</button><button type="button" @@click="refreshAll">刷新会话</button><button type="button" @@click="renameSession">重命名</button><button type="button" @@click="togglePin">{{selected?.pinned?'取消置顶':'置顶会话'}}</button><button type="button" class="danger" @@click="deleteSession">删除会话</button></div></details></div>
        </div>
        <div class="mobile-session-info mobile-only" v-if="selectedId">
            <button v-if="agent==='codex'" type="button" class="mobile-quota" :aria-label="quotaWorkspaceName + '，查看余量与工作空间'" :title="usageError || quotaWorkspaceName" @@click="openWorkspaceDialog">
                <span v-for="window in headerQuotaWindows" :key="window.minutes"><span>{{window.label}} · {{usageLoading?'读取中…':window.remaining==null?'暂无数据':'剩余 '+window.remaining+'%'}}</span><span v-if="window.remaining!=null" class="mobile-usage-track" :class="{low:window.remaining<20}"><i :style="{width:window.remaining+'%'}"></i></span></span>
            </button>
            <button type="button" class="mobile-context-info" :title="modelChipTitle" aria-label="上下文与模型设置" @@click="inspectorOpen=true"><span><template v-if="context.context?.available">{{contextTokens(context.context.tokens ?? 0)}} / {{contextTokens(context.context.limit)}} · {{contextPercent}}% · </template><template v-else>暂无用量数据 · </template>{{mobileModelSummary}}</span><span v-if="context.context?.available" class="mobile-usage-track" :class="{low:contextPercent>=90}"><i :style="{width:contextPercent+'%'}"></i></span></button>
        </div>
        <div v-if="agentSetup && agentSetup.state!=='ready'" class="agent-banner"><strong>{{agentSetup.title}}</strong><span>{{agentSetup.message}}</span><span v-if="setupNotice">{{setupNotice}}</span><i-button size="small" @@click="setupDetails=true">安装与配置步骤</i-button><i-button size="small" :disabled="setupBusy" @@click="loadAgentSetup">重新检测</i-button><i-button v-if="agentSetup.canConfigureApi" size="small" type="primary" :loading="setupBusy" @@click="configureAgentApi">一键配置并安全重启 API</i-button></div>
        <div v-if="error" class="agent-banner error" role="alert">{{readableAgentError(error)}} <button type="button" @@click="error=''">×</button></div>
        <div v-if="agent==='claude' && selected?.unresolved_run" class="agent-banner error"><strong>上一轮结果待核对</strong><span>{{selected.unresolved_run.error || '桥接中断，无法确认上一轮是否完成。'}} 请先查看历史与电脑上的实际修改；确认后才能继续发送，原任务不会自动重发。</span><i-button size="small" type="primary" :loading="acknowledging" @@click="acknowledgeUnresolved">我已核对，继续</i-button></div>
        <div v-if="agent==='claude' && selected?.rewind_pending" class="agent-banner"><strong>已撤回</strong><span>所选消息之后的内容已隐藏，下一条消息会从撤回位置继续；电脑上的原始记录在发送前不会改动。</span><i-button size="small" @@click="cancelRewind">取消撤回</i-button></div>
        <div v-if="context.question" class="agent-banner"><strong>需要回答</strong><span>{{questionText}}</span><i-button size="small" @@click="answerQuestion">回答</i-button></div>
        <div v-if="approval" class="agent-banner"><strong>需要确认</strong><span>{{approvalText}}</span><pre v-if="approval.command" class="agent-approval-command">{{approval.command}}</pre><div v-if="approval.kind==='user_input' && agent==='claude'" class="agent-approval-questions"><div v-for="question in approval.questions" :key="question.id" class="agent-approval-question"><strong>{{question.header ? question.header+' · ' : ''}}{{question.question}}<small v-if="question.multiSelect">（可多选）</small></strong><div class="agent-approval-options"><button v-for="option in question.options" :key="option.label" type="button" :class="{picked:approvalPicked(question,option.label)}" :title="option.description" :aria-pressed="approvalPicked(question,option.label)" @@click="toggleApprovalOption(question,option.label)">{{option.label}}</button></div><input type="text" :value="approvalOtherText(question)" :aria-label="'自定义回答：'+question.question" placeholder="或填写自己的回答" @@input="approvalOther(question,$event.target.value)"></div><div class="agent-approval-actions"><i-button size="small" type="primary" :disabled="approvalBusy || !approvalComplete()" @@click="submitApprovalAnswers">提交回答</i-button><i-button size="small" :disabled="approvalBusy" @@click="approve('deny')">不回答</i-button></div></div><i-button v-else-if="approval.kind==='user_input'" :disabled="approvalBusy" size="small" type="primary" @@click="answerApprovalQuestion">回答问题</i-button><template v-else><i-button v-for="choice in approvalChoices" :key="choice.id" :disabled="approvalBusy" :title="choice.detail" size="small" :type="choice.id==='deny'?'default':'primary'" @@click="approve(choice.id)">{{choice.label}}</i-button></template></div>
        <div v-if="agent==='codex' && permissionsMode==='full'" class="agent-banner"><span>权限设置：完全访问</span><i-button size="small" @@click="openPermissions">会话权限</i-button></div>
        <div v-if="externalRunning" class="agent-banner"><strong>{{agent==='claude'?(externalActivity?.external_status==='busy'?'电脑上正在执行':'会话被电脑占用'):'其他客户端正在执行'}}</strong><span>{{agent==='codex'?'可查看实时进度；中断并接管前不会从 Web 端发送新消息。':agent==='claude'?'电脑上的 Claude Code 正在使用此会话'+(externalActivity?.pid?'（PID '+externalActivity.pid+(externalActivity.external_status==='busy'?'，正在执行':'，空闲')+'）':'')+'。为避免两端同时写入，接管会先结束电脑上的这个进程；会话记录保留。':'新消息会排队，等当前轮结束后自动执行。'}}</span><i-button v-if="agent==='codex'" size="small" @@click="takeover">中断并接管</i-button><i-button v-else-if="agent==='claude'" size="small" type="primary" :loading="takingOver" @@click="takeover">{{externalActivity?.external_status==='busy'?'中断并接管':'结束电脑进程并接管'}}</i-button><template v-else-if="apiServer && !apiServer.enabled"><span class="agent-banner-warn">本机 Hermes 未启用 API Server，无法停止其他客户端的任务。</span><i-button size="small" :loading="enablingApiServer" @@click="enableApiServer(false)">启用 API Server</i-button><i-button size="small" @@click="enableApiServer(true)">写入并重启网关</i-button></template></div>
        <div class="agent-timeline-wrap">
        <div v-if="historyCacheState" class="agent-pending" role="status">{{historyCacheState==='failed'?'缓存 · 同步失败，可刷新重试':'缓存 · 正在同步最新消息'}}</div>
        <div v-if="historyLoading" class="agent-history-loading" role="status">正在加载会话…</div>
        <div ref="timeline" class="agent-timeline" :class="{'history-loading':historyLoading}" @@scroll="onTimelineScroll">
            <div class="agent-timeline-inner">
                <div v-if="!selectedId" class="agent-welcome"><div class="agent-welcome-mark">{{agentName==='Codex'?'✧':agentName==='Hermes'?'◇':'✻'}}</div><h2>在浏览器中使用 {{agentName}}</h2><p>选择左侧会话，或新建会话开始。</p></div>
                <template v-else>
                    <div class="agent-history-actions"><i-button v-if="historyHasMore" size="small" :loading="olderLoading" @@click="loadOlder">加载更早消息</i-button></div>
<template v-for="item in timeline" :key="item.kind==='live' ? (item.segment.messageUid?'uid-'+item.segment.messageUid:'live-'+item.segment.id) : messageKey(item.message)">
                    <article v-if="item.kind==='message'" :key="messageKey(item.message)" class="agent-message" :class="item.message.role==='user'?'from-user':item.message.role==='system'?'from-system':'from-agent'" @@contextmenu.prevent="openMessageMenu($event,item.message)">
                        <div class="agent-message-surface">
                        <div v-if="item.message.type==='interaction'" class="agent-interaction"><div class="agent-interaction-head">提问</div><div v-for="(entry,index) in (item.message.interactions||[])" :key="index" class="agent-interaction-entry"><div class="agent-interaction-question">{{entry.question || messageBody(item.message)}}</div><div v-if="entry.choices && entry.choices.length" class="agent-interaction-choices"><span v-for="(choice,ci) in entry.choices" :key="ci" class="agent-interaction-choice" :class="{picked:choice===entry.answer}">{{choice}}</span></div><div class="agent-interaction-answer"><span class="agent-interaction-label">回答</span><span>{{entry.answer || (entry.status==='declined'?'已取消':'未回答')}}</span></div></div></div><div v-else-if="messageBody(item.message) && markdownReady && item.message.role==='assistant'" class="agent-message-text agent-markdown" v-html="renderMarkdown(messageBody(item.message))" @@click="openMediaLink($event,item.message)"></div><div v-else-if="messageBody(item.message)" class="agent-message-text">{{messageBody(item.message)}}</div>
                        <div v-if="mediaFiles(item.message).length" class="agent-media-cards"><div v-for="file in mediaFiles(item.message)" :key="file.id" class="agent-media-card"><span class="agent-media-icon">{{mediaIcon(file)}}</span><div><strong>{{file.name || '附件'}}</strong><small>{{mediaKind(file)}} · {{formatBytes(file.size)}}</small></div><i-button v-if="canPreviewFile(file)" size="small" @@click="openFile(file)">预览</i-button><i-button size="small" @@click="downloadFile(file)">下载</i-button></div></div>
                        <div v-if="unresolvedMedia(item.message).length" class="agent-media-cards"><div v-for="marker in unresolvedMedia(item.message)" :key="marker.path" class="agent-media-card unavailable"><span class="agent-media-icon">▤</span><div><strong>{{mediaName(marker.path)}}</strong><small>文件暂未关联，无法预览或下载</small><small class="agent-media-path" :title="marker.path">{{marker.path}}</small></div><i-button size="small" @@click="showFiles">核对文件</i-button></div></div>
                        <div v-if="item.message.attachments?.some(file=>!linkedMediaIds(item.message).has(file.id)&&!String(file.mime||'').startsWith('image/'))" class="agent-attachments"><button v-for="file in item.message.attachments.filter(file=>!linkedMediaIds(item.message).has(file.id)&&!String(file.mime||'').startsWith('image/'))" :key="file.id" type="button" @@click="canPreviewFile(file)?openFile(file):downloadFile(file)" :title="canPreviewFile(file)?'预览文件':'下载文件'">📎 {{file.name || file.id}}</button></div>
                        <div v-if="item.message.attachments?.some(file=>!linkedMediaIds(item.message).has(file.id)&&file.mime?.startsWith('image/'))" class="agent-image-attachments"><img v-for="file in item.message.attachments.filter(file=>!linkedMediaIds(item.message).has(file.id)&&file.mime?.startsWith('image/'))" :key="file.id" :src="file.url" :alt="file.name || '图片附件'" loading="lazy" @@click="openFile(file)"></div>
                        <div v-if="item.message.tool_summary_id" class="agent-tool"><i-button size="small" @@click="showTool(item.message.tool_summary_id)">查看工具记录</i-button></div>
                        <div class="agent-message-meta"><strong>{{roleLabel(item.message)}}</strong><span v-if="item.message.delivery" class="delivery-state">{{item.message.delivery}}</span><span>{{messageClockLabel(item.message)}}</span><button v-if="item.message.id &amp;&amp; ['user','assistant'].includes(item.message.role)" type="button" class="mobile-message-menu mobile-only" aria-label="消息操作" aria-haspopup="menu" title="复制、分叉或编辑消息" @@click.stop="openMessageMenu($event,item.message)">操作</button></div>
                        </div>
                    </article>
                    <article v-else class="agent-message from-agent live-segment" :class="{'agent-reasoning':item.segment.reasoning,'is-collapsing':item.segment.collapsing}"><div class="agent-message-surface"><div class="agent-message-text">{{item.segment.text}}</div><div class="agent-message-meta"><strong>{{agentName}}</strong><span>{{item.segment.reasoning?'🧠':item.segment.phase==='final_answer'?'正在回复':'实时进度'}}</span></div></div></article>
</template>
                    <div v-if="(activeRun||externalRunning) && liveTools.length" class="agent-live-tools" :class="{collapsed:toolsCollapsed}"><div class="agent-live-tools-head" role="button" tabindex="0" :aria-expanded="!toolsCollapsed" @@click="toolsCollapsed=!toolsCollapsed" @@keydown.enter.prevent="toolsCollapsed=!toolsCollapsed" @@keydown.space.prevent="toolsCollapsed=!toolsCollapsed"><span class="agent-live-tools-caret" aria-hidden="true">{{toolsCollapsed?'▸':'▾'}}</span><strong>工具调用 · {{liveTools.length}}</strong><small>{{toolsCollapsed?(liveTools.at(-1)?.tool||''):''}}</small><i-button size="small" @@click.stop="showActiveTools()">查看运行详情</i-button></div><div v-show="!toolsCollapsed" class="agent-live-tools-body"><div v-for="tool in liveTools" :key="tool.id" class="agent-live-tool"><button type="button" class="agent-live-tool-head" @@click="showActiveTools(tool)"><span class="tool-state" :class="tool.status">{{tool.status==='running'?'运行中':tool.status==='failed'?'失败':'完成'}}</span><strong>{{tool.tool || '工具'}}</strong><small>{{tool.preview || '查看详情'}}</small></button></div></div></div>
                    <div v-if="activeRun||externalRunning" class="agent-running"><span class="pulse-dot"></span>{{statusText}}<span v-if="activeRun" class="agent-stream-state">{{streamConnected?'实时连接':'正在核对状态'}}</span><i-button v-if="activeRun" size="small" title="停止当前执行中的任务，会话仍保留" @@click="stopRun">停止当前任务</i-button></div>
                </template>
            </div>
        </div>
        <button v-if="showJumpToLatest && selectedId" type="button" class="agent-jump-latest" title="回到最新消息" aria-label="回到最新消息" @@click="jumpToLatest"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 4v12.17l5.59-5.59L19 12l-7 7-7-7 1.41-1.41L11 16.17V4z"/></svg></button>
        </div>
        <div class="agent-compose-wrap" v-if="selectedId">
            <div class="agent-compose-top"><div class="agent-context-meter"><button type="button" class="agent-model-chip" :title="modelChipTitle" @@click="inspectorOpen=true">{{modelChipLabel}}</button><template v-if="context.context?.available"><i-progress :percent="contextPercent" :stroke-width="6" hide-info></i-progress><small :title="`${context.context.tokens || 0} / ${context.context.limit || '—'} tokens`">{{contextTokens(context.context.tokens ?? 0)}} / {{contextTokens(context.context.limit)}} · {{contextPercent}}%</small></template><small v-else>暂无用量数据</small></div><div class="agent-compose-tools"><i-button size="small" @@click="showFiles">会话文件</i-button><i-button size="small" @@click="compact">压缩上下文</i-button></div></div>
            <div v-if="pending" class="agent-pending"><span>{{pending.delivery}}</span><i-button size="small" @@click="verifyPending">核对发送状态</i-button><i-button v-if="pending.checkedMissing" size="small" @@click="clearUnconfirmed">清除本地记录</i-button></div>
            <div v-if="attachments.length" class="agent-attachment-drafts"><span v-for="(file,index) in attachments" :key="file.id">{{file.name}} <button type="button" @@click="attachments.splice(index,1)">×</button></span></div>
            <div v-if="schedules.length" class="agent-schedules"><span v-for="row in schedules" :key="row.id" class="agent-schedule-chip" :title="'定时发送：'+row.text">⏰ {{scheduleChip(row)}}<button type="button" @@click="cancelSchedule(row.id)" aria-label="取消定时消息">×</button></span></div>
            <div class="agent-compose-input-row">
                <button type="button" class="mobile-compose-more mobile-only" aria-label="消息工具" aria-haspopup="dialog" :disabled="uploading" @@click="mobileComposerOpen=true">☰</button>
                <textarea ref="composer" v-model="draft" :disabled="sending" :placeholder="mobileViewport?'消息':'发送消息；Shift+Enter 换行；可直接粘贴图片'" aria-label="消息输入" :rows="mobileViewport?1:3" @@input="resizeComposer" @@keydown="composerKeydown" @@paste="onPaste"></textarea>
                <button type="button" class="mobile-compose-attach mobile-only" aria-label="添加附件" :disabled="uploading" @@click="$refs.composeUpload.click()"><img src="/icons/attach_file.svg" alt=""></button>
                <button v-if="activeRun &amp;&amp; !draft.trim()" type="button" class="mobile-compose-send mobile-only" aria-label="停止当前任务" @@click="stopRun">■</button>
