@{
    Layout = "_Layout";
}
@section Styles {
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/agent-workspace.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/web-api.js" asp-append-version="true"></script>
    <script src="~/js/web-sse.js" asp-append-version="true"></script>
    @if (ViewBag.Agent == "codex") {
        <script src="~/vendor/markdown-it/markdown-it.min.js" asp-append-version="true"></script>
    }
    <script src="~/js/agent-workspace.js" asp-append-version="true"></script>
}
<div id="agent-app" class="agent-workspace" data-agent="@ViewBag.Agent" v-cloak>
    <div v-if="sessionsOpen" class="agent-sessions-backdrop" @@click="sessionsOpen=false"></div>
    <aside class="agent-sessions" :class="{'mobile-open':sessionsOpen}">
        <div class="agent-pane-head"><div class="agent-pane-identity"><span class="agent-brand-icon"><img :src="agent==='codex'?'/icons/codex.png':'/icons/hermes.svg'" :alt="agentName"></span><div><small>会话列表</small><h2>{{agentName}}</h2></div></div><i-button v-if="agent==='codex'" size="small" :icon="groupByProject?'md-list':'md-folder'" :title="groupByProject?'按最近会话显示':'按项目分组'" @@click="toggleGroupMode"></i-button><i-button type="primary" size="small" icon="md-add" @@click="openCreateDialog">新建</i-button><button class="agent-sessions-close" type="button" @@click="sessionsOpen=false" aria-label="收起会话列表">×</button></div>
        <div class="agent-search"><i-input v-model="search" search placeholder="搜索会话" clearable></i-input></div>
        <div v-if="listError" class="agent-inline-error">{{listError}} <i-button size="small" @@click="refreshSessions">重试</i-button></div>
        <div class="agent-session-list">
            <template v-for="group in displayedGroups" :key="group.key"><button v-if="groupByProject && agent==='codex' && group.name" type="button" class="agent-session-group" @@click="toggleGroup(group.name)"><span>{{group.name}}</span><span class="agent-session-group-count">{{group.rows.length}}</span><span class="agent-session-group-caret">{{collapsedGroups.includes(group.name)?'▸':'▾'}}</span></button><button v-for="item in groupRows(group)" :key="item.id" type="button" class="agent-session-item" :class="{active:item.id===selectedId}" @@click="select(item)" @@contextmenu.prevent="openSessionMenu($event,item)"><span class="agent-session-heading"><span class="agent-session-title"><span v-if="item.pinned" title="置顶">◆</span>{{item.title || '未命名会话'}}</span><span v-if="sessionRunning(item)" class="agent-session-running">运行中</span></span><span class="agent-session-preview">{{item.preview || item.latest_user_message || item.cwd || '打开会话'}}</span><span class="agent-session-foot"><span v-if="item.archived" class="agent-session-archived">已存档</span><span class="agent-session-location">{{item.cwd || (agent==='codex'?'Codex 会话':'Hermes 会话')}}</span><span class="agent-session-time">{{time(item.last_active || item.started_at)}}</span></span></button></template></template>
            <div v-if="!filteredSessions.length && !loadingList" class="agent-list-empty">暂无会话</div>
            <i-button v-if="hasMore" long size="small" :loading="loadingList" @@click="moreSessions">加载更多</i-button>
        </div>
    </aside>
    <section class="agent-conversation">
        <div class="agent-conversation-head">
            <div class="agent-conversation-title"><button class="agent-mobile-sessions" type="button" @@click="sessionsOpen=!sessionsOpen" :aria-expanded="sessionsOpen" aria-label="显示会话列表">☰</button><span class="agent-conversation-icon"><img :src="agent==='codex'?'/icons/codex.png':'/icons/hermes.svg'" :alt="agentName"></span><div><h2>{{selected?.title || agentName}}</h2><button v-if="agent==='codex'" type="button" class="agent-quota-summary" @@click="openWorkspaceDialog" :title="usageError || '查看工作空间用量和切换工作空间'"><span>{{currentWorkspaceName}}</span><span class="agent-header-quota-windows"><span v-for="window in headerQuotaWindows" :key="window.minutes" class="agent-header-quota-window"><span>{{window.label}} · {{usageLoading?'读取中…':window.remaining==null?'暂无数据':'剩余 '+window.remaining+'%'}}</span><span v-if="window.remaining!=null" class="agent-header-quota-track" :class="{low:window.remaining<20}"><span :style="{width:window.remaining+'%'}"></span></span></span></span></button><small>{{selected?.cwd || statusText}}</small></div></div>
            <div class="agent-head-trailing"><span class="agent-status-pill"><span></span>{{statusText}}</span><details class="agent-session-actions"><summary aria-label="会话操作" title="会话操作">⋮</summary><div><button type="button" @@click="refreshAll">刷新会话</button><button type="button" @@click="renameSession">重命名</button><button type="button" @@click="togglePin">{{selected?.pinned?'取消置顶':'置顶会话'}}</button><button type="button" class="danger" @@click="deleteSession">删除会话</button></div></details></div>
        </div>
        <div v-if="error" class="agent-banner error" role="alert">{{error}} <button type="button" @@click="error=''">×</button></div>
        <div v-if="context.question" class="agent-banner"><strong>需要回答</strong><span>{{questionText}}</span><i-button size="small" @@click="answerQuestion">回答</i-button></div>
        <div v-if="approval" class="agent-banner"><strong>需要确认</strong><span>{{approvalText}}</span><i-button v-if="approval.kind==='user_input'" size="small" type="primary" @@click="answerApprovalQuestion">回答问题</i-button><template v-else><i-button size="small" type="primary" @@click="approve('once')">仅本次允许</i-button><i-button size="small" @@click="approve('deny')">拒绝</i-button></template></div>
        <div v-if="externalRunning" class="agent-banner"><strong>其他客户端正在执行</strong><span>{{agent==='codex'?'可查看实时进度；中断并接管前不会从 Web 端发送新消息。':'新消息会排队，等当前轮结束后自动执行。'}}</span><i-button v-if="agent==='codex'" size="small" @@click="takeover">中断并接管</i-button><template v-else-if="apiServer && !apiServer.enabled"><span class="agent-banner-warn">本机 Hermes 未启用 API Server，无法停止其他客户端的任务。</span><i-button size="small" :loading="enablingApiServer" @@click="enableApiServer(false)">启用 API Server</i-button><i-button size="small" @@click="enableApiServer(true)">写入并重启网关</i-button></template></div>
        <div class="agent-timeline-wrap">
        <div v-if="historyLoading" class="agent-history-loading" role="status">正在加载会话…</div>
        <div ref="timeline" class="agent-timeline" :class="{'history-loading':historyLoading}" @@scroll="onTimelineScroll">
            <div class="agent-timeline-inner">
                <div v-if="!selectedId" class="agent-welcome"><div class="agent-welcome-mark">{{agentName==='Codex'?'✧':'◇'}}</div><h2>在浏览器中使用 {{agentName}}</h2><p>选择左侧会话，或新建会话开始。</p></div>
                <template v-else>
                    <div class="agent-history-actions"><i-button v-if="historyHasMore" size="small" :loading="olderLoading" @@click="loadOlder">加载更早消息</i-button></div>
<template v-for="item in timeline" :key="item.kind==='live' ? 'live-'+item.segment.id : messageKey(item.message)">
                    <article v-if="item.kind==='message'" :key="messageKey(item.message)" class="agent-message" :class="item.message.role==='user'?'from-user':item.message.role==='system'?'from-system':'from-agent'" @@contextmenu.prevent="openMessageMenu($event,item.message)">
                        <div class="agent-message-surface">
                        <div v-if="item.message.type==='interaction'" class="agent-interaction"><div class="agent-interaction-head">提问</div><div v-for="(entry,index) in (item.message.interactions||[])" :key="index" class="agent-interaction-entry"><div class="agent-interaction-question">{{entry.question || messageBody(item.message)}}</div><div v-if="entry.choices && entry.choices.length" class="agent-interaction-choices"><span v-for="(choice,ci) in entry.choices" :key="ci" class="agent-interaction-choice" :class="{picked:choice===entry.answer}">{{choice}}</span></div><div class="agent-interaction-answer"><span class="agent-interaction-label">回答</span><span>{{entry.answer || (entry.status==='declined'?'已取消':'未回答')}}</span></div></div></div><div v-else-if="messageBody(item.message) && markdownReady && item.message.role==='assistant'" class="agent-message-text agent-markdown" v-html="renderMarkdown(messageBody(item.message))"></div><div v-else-if="messageBody(item.message)" class="agent-message-text">{{messageBody(item.message)}}</div>
                        <div v-if="mediaFiles(item.message).length" class="agent-media-cards"><div v-for="file in mediaFiles(item.message)" :key="file.id" class="agent-media-card"><span class="agent-media-icon">{{mediaIcon(file)}}</span><div><strong>{{file.name || '附件'}}</strong><small>{{mediaKind(file)}} · {{formatBytes(file.size)}}</small></div><i-button v-if="canPreviewFile(file)" size="small" @@click="openFile(file)">预览</i-button><i-button size="small" @@click="downloadFile(file)">下载</i-button></div></div>
                        <div v-if="unresolvedMedia(item.message).length" class="agent-media-cards"><div v-for="marker in unresolvedMedia(item.message)" :key="marker.path" class="agent-media-card unavailable"><span class="agent-media-icon">▤</span><div><strong>{{mediaName(marker.path)}}</strong><small>文件暂未关联，无法预览或下载</small><small class="agent-media-path" :title="marker.path">{{marker.path}}</small></div><i-button size="small" @@click="showFiles">核对文件</i-button></div></div>
                        <div v-if="item.message.attachments?.some(file=>!linkedMediaIds(item.message).has(file.id))" class="agent-attachments"><button v-for="file in item.message.attachments.filter(file=>!linkedMediaIds(item.message).has(file.id))" :key="file.id" type="button" @@click="canPreviewFile(file)?openFile(file):downloadFile(file)" :title="canPreviewFile(file)?'预览文件':'下载文件'">📎 {{file.name || file.id}}</button></div>
                        <div v-if="item.message.attachments?.some(file=>!linkedMediaIds(item.message).has(file.id)&&file.mime?.startsWith('image/'))" class="agent-image-attachments"><img v-for="file in item.message.attachments.filter(file=>!linkedMediaIds(item.message).has(file.id)&&file.mime?.startsWith('image/'))" :key="file.id" :src="file.url" :alt="file.name || '图片附件'" loading="lazy" @@click="openFile(file)"></div>
                        <div v-if="item.message.tool_summary_id" class="agent-tool"><i-button size="small" @@click="showTool(item.message.tool_summary_id)">查看工具记录</i-button></div>
                        <div class="agent-message-meta"><strong>{{roleLabel(item.message)}}</strong><span v-if="item.message.delivery" class="delivery-state">{{item.message.delivery}}</span><span>{{time(item.message.timestamp)}}</span></div>
                        </div>
                    </article>
                    <article v-else class="agent-message from-agent live-segment"><div class="agent-message-surface"><div class="agent-message-text">{{item.segment.text}}</div><div class="agent-message-meta"><strong>{{agentName}}</strong><span>{{item.segment.phase==='final_answer'?'正在回复':'实时进度'}}</span></div></div></article>
</template>
                    <div v-if="(activeRun||externalRunning) && liveTools.length" class="agent-live-tools" :class="{collapsed:toolsCollapsed}"><div class="agent-live-tools-head" role="button" tabindex="0" :aria-expanded="!toolsCollapsed" @@click="toolsCollapsed=!toolsCollapsed" @@keydown.enter.prevent="toolsCollapsed=!toolsCollapsed" @@keydown.space.prevent="toolsCollapsed=!toolsCollapsed"><span class="agent-live-tools-caret" aria-hidden="true">{{toolsCollapsed?'▸':'▾'}}</span><strong>工具调用 · {{liveTools.length}}</strong><small>{{toolsCollapsed?(liveTools.at(-1)?.tool||''):''}}</small><i-button size="small" @@click.stop="showActiveTools()">查看运行详情</i-button></div><div v-show="!toolsCollapsed" class="agent-live-tools-body"><div v-for="tool in liveTools" :key="tool.id" class="agent-live-tool"><button type="button" class="agent-live-tool-head" @@click="showActiveTools(tool)"><span class="tool-state" :class="tool.status">{{tool.status==='running'?'运行中':tool.status==='failed'?'失败':'完成'}}</span><strong>{{tool.tool || '工具'}}</strong><small>{{tool.preview || '查看详情'}}</small></button></div></div></div>
                    <div v-if="activeRun||externalRunning" class="agent-running"><span class="pulse-dot"></span>{{statusText}}<span v-if="activeRun" class="agent-stream-state">{{streamConnected?'实时连接':'正在核对状态'}}</span><i-button v-if="activeRun" size="small" title="停止当前执行中的任务，会话仍保留" @@click="stopRun">停止当前任务</i-button></div>
                </template>
            </div>
        </div>
        <button v-if="showJumpToLatest && selectedId" type="button" class="agent-jump-latest" title="回到最新消息" aria-label="回到最新消息" @@click="jumpToLatest"><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M12 4v12.17l5.59-5.59L19 12l-7 7-7-7 1.41-1.41L11 16.17V4z"/></svg></button>
        </div>
        <div class="agent-compose-wrap" v-if="selectedId">
            <div class="agent-compose-top"><div class="agent-context-meter"><button type="button" class="agent-model-chip" :title="modelChipTitle" @@click="inspectorOpen=true">{{modelChipLabel}}</button><template v-if="context.context?.available"><i-progress :percent="contextPercent" :stroke-width="6" hide-info></i-progress><small :title="`${context.context.tokens || 0} / ${context.context.limit || '—'} tokens`">{{contextTokens(context.context.tokens ?? 0)}} / {{contextTokens(context.context.limit)}} · {{contextPercent}}%</small></template><small v-else>暂无用量数据</small></div><div class="agent-compose-tools"><i-button size="small" @@click="showFiles">会话文件</i-button><i-button size="small" @@click="compact">压缩上下文</i-button></div></div>
            <div v-if="pending" class="agent-pending"><span>{{pending.delivery}}</span><i-button size="small" @@click="verifyPending">核对发送状态</i-button><i-button v-if="pending.checkedMissing" size="small" @@click="clearUnconfirmed">清除本地记录</i-button></div>
            <div v-if="attachments.length" class="agent-attachment-drafts"><span v-for="(file,index) in attachments" :key="file.id">{{file.name}} <button type="button" @@click="attachments.splice(index,1)">×</button></span></div>
            <textarea v-model="draft" :disabled="sending" placeholder="发送消息；Shift+Enter 换行；可直接粘贴图片" rows="3" @@keydown="composerKeydown" @@paste="onPaste"></textarea>
            <div class="agent-compose-actions"><div><label class="agent-upload-label"><input type="file" multiple @@change="uploadFiles" :disabled="uploading"><span class="agent-upload-icon" aria-hidden="true"></span><span>添加文件</span></label><span v-if="uploading">上传中…</span><span v-if="activeRun">当前任务执行中，可插话</span></div><div class="agent-send-actions"><i-button v-if="agent==='codex'" size="small" :disabled="!draft.trim() || !!pending || externalRunning" @@click="enqueue">加入队列</i-button><i-button type="primary" :loading="sending" :disabled="!draft.trim() || !!pending || (externalRunning && agent==='codex')" @@click="send">{{activeRun?'插话':'发送'}}</i-button></div></div>
        </div>
    </section>
    <div class="agent-inspector-scrim" v-if="inspectorOpen && selectedId" @@click="inspectorOpen=false"></div>
    <aside class="agent-inspector" v-show="selectedId && inspectorOpen">
        <div class="agent-inspector-head"><div><small>SESSION DETAILS</small><h3>会话信息</h3></div><button type="button" class="agent-inspector-close" title="关闭" @@click="inspectorOpen=false">✕</button></div><div class="inspector-section" v-if="agent==='hermes' && apiServer"><h4>Hermes API Server</h4><p v-if="apiServer.enabled">已启用 · {{apiServer.host || '127.0.0.1'}}:{{apiServer.port || '8642'}}{{apiServer.key_set?' · 密钥已配置':' · 缺少密钥'}}</p><p v-else>未启用。其他客户端正在运行的会话无法被停止；启用后可按运行 id 中止。</p><i-button v-if="!apiServer.enabled" size="small" :loading="enablingApiServer" @@click="enableApiServer(false)">启用 API Server</i-button><span class="inspector-note" v-if="!apiServer.enabled">启用需要重启 Hermes 网关；上一按钮只写入配置并提示，你也可以在下方手动重启本机 Hermes。</span></div>
        <dl><dt>状态</dt><dd>{{statusText}}</dd><dt>模型</dt><dd>{{selected?.model || modelSelection.model || '默认'}}</dd><dt>工作目录</dt><dd class="path-value">{{selected?.cwd || '—'}}</dd></dl>
        <div class="inspector-section"><h4>模型设置</h4><select v-model="modelSelection.provider" @@change="providerChanged"><option value="">默认提供方</option><option v-for="item in providerChoices" :key="item.id" :value="item.id">{{item.name}}</option></select><select v-model="modelSelection.model"><option value="">默认模型</option><option v-for="item in modelChoices" :key="item.id" :value="item.id">{{item.name}}</option></select><select v-model="modelSelection.effort" aria-label="推理强度"><option value="">默认推理强度</option><option v-for="effort in effortChoices" :key="effort" :value="effort">{{effort}}</option></select><select v-if="agent==='codex'" v-model="modelSelection.tier" aria-label="服务等级"><option value="">默认速度</option><option v-if="!tierChoices.includes('default')" value="default">标准速度</option><option v-if="modelSelection.tier && modelSelection.tier!=='default' && !tierChoices.includes(modelSelection.tier)" :value="modelSelection.tier">当前速度 · {{modelSelection.tier}}</option><option v-for="tier in tierChoices" :key="tier" :value="tier">{{tier==='default'?'标准速度':tier==='fast'?'快速':tier}}</option></select><i-button size="small" long @@click="saveModel">应用到会话</i-button></div>
        <div class="inspector-section" v-if="agent==='codex'"><h4>消息队列</h4><div v-if="queue.length" v-for="item in queue" :key="item.id" class="queue-row"><span>{{queueText(item)}}</span><i-button size="small" type="text" @@click="removeQueued(item)">删除</i-button></div><p v-else>队列为空</p></div>
        <div class="inspector-section" v-if="agent==='codex'"><h4>Codex 账户</h4><p v-if="accounts.current_identity">{{accounts.current_identity.email || accounts.current_identity.name || accounts.current}}</p><select v-model="selectedAccount" aria-label="Codex 账户"><option v-for="item in accounts.data || []" :key="item.id" :value="item.id">{{item.name || item.email || item.id}}</option></select><i-button size="small" long :disabled="!selectedAccount || selectedAccount===accounts.current" @@click="useAccount">切换账户</i-button></div>
        <div class="inspector-section"><h4>操作</h4><i-button size="small" long @@click="showActiveTools()">工具调用详情</i-button><i-button size="small" long @@click="showFiles">查看附件</i-button></div>
    </aside>
    <div v-if="messageMenu" class="agent-context-menu" :style="{left:messageMenu.x+'px',top:messageMenu.y+'px'}" role="menu"><button type="button" role="menuitem" @@click="copyMessage(messageMenu.message)">复制消息</button><button v-if="messageMenu.message.id && ['user','assistant'].includes(messageMenu.message.role)" type="button" role="menuitem" @@click="forkMessage(messageMenu.message)">从这里分叉</button><button v-if="canEditMessage(messageMenu.message)" type="button" role="menuitem" @@click="editMessage(messageMenu.message)">撤回并编辑</button></div>
    <div v-if="sessionMenu" class="agent-context-menu" :style="{left:sessionMenu.x+'px',top:sessionMenu.y+'px'}" role="menu"><button type="button" role="menuitem" @@click="select(sessionMenu.session)">打开会话</button><button type="button" role="menuitem" @@click="renameSession(sessionMenu.session)">重命名</button><button type="button" role="menuitem" @@click="togglePin(sessionMenu.session)">{{sessionMenu.session.pinned?'取消置顶':'置顶会话'}}</button><button type="button" role="menuitem" @@click="refreshSessions()">刷新列表</button><button v-if="agent==='codex'" type="button" role="menuitem" @@click="openMoveDialog(sessionMenu.session)">移动到项目</button><button v-if="agent==='codex'" type="button" role="menuitem" @@click="toggleArchiveSession(sessionMenu.session)">{{sessionMenu.session.archived?'取消存档':'存档会话'}}</button><button type="button" role="menuitem" class="danger" @@click="deleteSession(sessionMenu.session)">删除会话</button></div>
    <modal v-model="showMoveDialog" title="移动到项目" :footer-hide="true" width="480">
        <div class="agent-create-form">
            <p v-if="moveTarget" class="agent-create-hint">会话「{{moveTarget.title || '未命名会话'}}」当前归属：{{moveTarget.group_name || '无项目'}}</p>
            <i-input v-model="moveSearch" search placeholder="搜索项目" clearable></i-input>
            <div class="agent-create-projects">
                <button type="button" class="agent-create-project" :class="{active: moveTarget && !moveTarget.project_id}" :disabled="moveMoving || (moveTarget && !moveTarget.project_id)" @@click="doMove('')"><strong>无项目</strong><span v-if="moveTarget && !moveTarget.project_id">当前归属</span></button>
                <button type="button" v-for="project in filteredMoveProjects" :key="project.id" class="agent-create-project" :class="{active: moveTarget && moveTarget.project_id === project.id}" :disabled="moveMoving || (moveTarget && moveTarget.project_id === project.id)" @@click="doMove(project.id)"><strong>{{project.name}}</strong><span v-for="root in projectRootsOf(project)" :key="root">{{root}}</span><span v-if="moveTarget && moveTarget.project_id === project.id">当前归属</span></button>
                <p v-if="!filteredMoveProjects.length" class="agent-create-hint">没有匹配项目</p>
            </div>
            <p v-if="moveError" class="agent-create-error">{{moveError}}</p>
            <div class="agent-create-actions"><i-button @@click="showMoveDialog=false">取消</i-button></div>
        </div>
    </modal>
    <modal v-model="showWorkspaceDialog" title="Codex 工作空间与用量" :mask-closable="!switchingWorkspace" :closable="!switchingWorkspace" :footer-hide="true" width="640">
        <div class="agent-workspace-quotas">
            <div class="agent-quota-toolbar"><span>5 小时与周额度均显示剩余比例</span><i-button size="small" :loading="workspaceLoading" :disabled="!!switchingWorkspace" @@click="refreshWorkspaces(true)">刷新用量</i-button></div>
            <p v-if="workspaceError" class="agent-inline-error" role="alert">{{workspaceError}}</p>
            <p v-if="workspaceLoading && !(workspaces.data || []).length">正在读取工作空间…</p>
            <p v-if="!workspaceLoading && !workspaceError && !(workspaces.data || []).length">暂无已保存的工作空间，请先在 App 或桌面登录。</p>
            <section v-for="row in workspaces.data || []" :key="row.id" class="agent-workspace-quota" :class="{current:row.id===workspaces.current}">
                <div class="agent-workspace-quota-content"><header><div><strong>{{workspaceName(row)}}</strong><small>{{row.email}} · {{row.plan_type || '官方账户'}}</small></div><span v-if="row.id===workspaces.current">当前工作空间</span></header>
                <template v-if="workspaceUsages[row.id]?.available"><div v-for="group in quotaGroups(workspaceUsages[row.id].usage)" :key="group.name" class="agent-quota-group"><small>{{group.name}}</small><div class="agent-quota-windows"><div v-for="window in group.windows" :key="window.label"><div>{{window.label}} · {{window.remaining==null?'暂无数据':'剩余 '+window.remaining+'%'}}</div><i-progress v-if="window.remaining!=null" :percent="window.remaining" :status="window.remaining<20?'wrong':'normal'" :stroke-width="4" hide-info></i-progress><small v-if="window.resetsAt">重置：{{time(window.resetsAt)}}</small></div></div></div><p v-if="!quotaGroups(workspaceUsages[row.id].usage).length">暂无额度窗口数据</p></template>
                <p v-else>{{workspaceUsages[row.id]?.error || (workspaceLoading?'正在读取用量…':'暂无用量数据')}}</p>
                </div><i-button v-if="row.id!==workspaces.current" class="agent-workspace-switch" size="large" :loading="switchingWorkspace===row.id" :disabled="!!switchingWorkspace || !!activeRun || externalRunning || sending || !!pending" @@click="useWorkspace(row)">切换</i-button>
            </section>
        </div>
    </modal>
    <modal v-model="showCreateDialog" :title="'新建 '+agentName+' 会话'" :mask-closable="!creating" :footer-hide="true" width="560">
        <div class="agent-create-form"><label for="agent-create-title">会话名称</label><i-input v-model="createTitle" id="agent-create-title" placeholder="为会话命名" @@on-enter="newSession"></i-input>
            <template v-if="agent==='codex'"><label>工作项目</label>
                <div class="agent-create-modes"><button type="button" v-for="m in [['existing','已有项目'],['new','新项目'],['none','无项目']]" :key="m[0]" class="agent-create-mode" :class="{active:createMode===m[0]}" @@click="createMode=m[0]" :disabled="creating">{{m[1]}}</button></div>
                <template v-if="createMode==='existing'"><i-input v-model="createProjectSearch" placeholder="搜索电脑上的项目" :disabled="creating"></i-input>
                    <div class="agent-create-projects"><button type="button" v-for="project in filteredCreateProjects" :key="project.id" class="agent-create-project" :class="{active:createProjectId===project.id}" @@click="pickCreateProject(project)" :disabled="creating"><strong>{{project.name}}</strong><span v-for="root in projectRootsOf(project)" :key="root">{{root}}</span></button>
                        <p v-if="!filteredCreateProjects.length" class="agent-create-hint">没有匹配项目，可切换“新项目”或“无项目”。</p></div>
                    <template v-if="createProjectRoots.length"><label>工作目录 · 会话将在此目录中执行</label>
                        <label v-for="root in createProjectRoots" :key="root" class="agent-create-root"><input type="radio" :value="root" v-model="createRoot" :disabled="creating"><span>{{root}}</span></label></template>
                </template>
                <template v-else-if="createMode==='new'"><label for="agent-create-project-name">项目名称</label><i-input v-model="createProjectName" id="agent-create-project-name" placeholder="项目名称" :disabled="creating"></i-input>
                    <label>项目文件夹 · 单选指定默认工作目录（最多 16 个）</label>
                    <label v-for="path in createRoots" :key="path" class="agent-create-root"><input type="radio" :value="path" v-model="createRoot" :disabled="creating"><span>{{path}}</span><button type="button" class="agent-create-root-remove" @@click="toggleCreateRoot(path)" :disabled="creating" aria-label="移除文件夹">×</button></label>
                    <p v-if="!createRoots.length" class="agent-create-hint">还没有文件夹，点下方“浏览电脑目录”添加。</p>
                    <div class="agent-create-browse"><i-button size="small" :disabled="creating||createRoots.length>=16" @@click="openCreateBrowser">浏览电脑目录</i-button><span class="agent-create-hint">可选择多个现有目录，也可在浏览器中新建文件夹。</span></div></template>
                <template v-else><p class="agent-create-hint">独立会话，不归入项目。使用独立工作目录保存本次会话的文件。</p></template>
            </template>
            <p v-if="createError" class="agent-create-error">{{createError}}</p>
            <div class="agent-create-actions"><i-button @@click="showCreateDialog=false" :disabled="creating">取消</i-button><i-button type="primary" :loading="creating" :disabled="!createValid" @@click="newSession">创建会话</i-button></div></div>
    </modal>
    <modal v-model="createBrowser" title="选择项目工作目录" :footer-hide="true" width="560">
        <div class="agent-create-browser"><div class="agent-create-browser-path"><code>{{createBrowserPath || '此电脑'}}</code><i-button size="small" :disabled="!createBrowserPath||createBrowserLoading" @@click="createBrowserUp">上级</i-button></div>
            <div class="agent-create-browser-list"><button type="button" v-for="dir in createBrowserDirs" :key="dir.path" class="agent-create-browser-item" @@click="enterCreateBrowser(dir)" :disabled="createBrowserLoading"><span class="agent-create-browser-icon" aria-hidden="true"></span><span>{{dir.name}}</span></button>
                <p v-if="createBrowserLoading" class="agent-create-hint">读取中…</p><p v-else-if="!createBrowserDirs.length" class="agent-create-hint">没有子目录。</p></div>
            <p v-if="createBrowserError" class="agent-create-error">{{createBrowserError}}</p>
            <div class="agent-create-browser-new"><i-input v-model="createBrowserNew" placeholder="新文件夹名称" :disabled="!createBrowserPath||createBrowserMkdir"></i-input><i-button size="small" :disabled="!createBrowserNew.trim()||!createBrowserPath||createBrowserMkdir" :loading="createBrowserMkdir" @@click="mkdirInCreateBrowser">新建</i-button></div>
            <div class="agent-create-actions"><i-button @@click="createBrowser=false">取消</i-button><i-button type="primary" :disabled="!createBrowserPath" @@click="useCreateBrowserDir">使用此目录</i-button></div></div>
    </modal>
    <modal v-model="showEditDialog" title="撤回并编辑消息" :mask-closable="!editing" :footer-hide="true" width="560"><div class="agent-create-form"><p>确认后会回退这条消息之后的内容，再发送编辑后的消息。</p><label for="agent-edit-text">消息内容</label><textarea id="agent-edit-text" v-model="editText" rows="7"></textarea><div v-if="editFiles.length" class="agent-attachment-drafts"><span v-for="(file,index) in editFiles" :key="file.id">{{file.name}} <button type="button" @@click="editFiles.splice(index,1)">×</button></span></div><label class="agent-upload-label"><input type="file" multiple @@change="uploadEditFiles" :disabled="editing"><span class="agent-upload-icon" aria-hidden="true"></span><span>添加附件</span></label><p v-if="editError" class="agent-create-error">{{editError}}</p><div class="agent-create-actions"><i-button @@click="showEditDialog=false" :disabled="editing">取消</i-button><i-button type="primary" :loading="editing" :disabled="!editText.trim()" @@click="submitEdit">撤回并重发</i-button></div></div></modal>
    <div v-if="dialog" class="workspace-modal-backdrop" @@click.self="dialog=null"><div class="workspace-modal" role="dialog" aria-modal="true"><div class="workspace-modal-head"><h2>{{dialog.title}}</h2><i-button size="small" @@click="dialog=null">关闭</i-button></div><div class="workspace-modal-body"><pre v-if="dialog.text">{{dialog.text}}</pre><div v-for="tool in dialog.tools" :key="tool.id" class="agent-tool-detail"><div><strong>{{tool.tool || '工具'}}</strong><span class="tool-state" :class="tool.status">{{tool.status || '运行中'}}</span></div><pre>{{tool.description || tool.preview || '暂无参数详情'}}</pre></div><div v-for="file in dialog.files" :key="file.id" class="history-row"><i-button type="text" :title="canPreviewFile(file)?'预览文件':'下载文件'" @@click="canPreviewFile(file)?openFile(file):downloadFile(file)">{{file.name || file.id}}</i-button> · {{file.size || 0}} B</div><i-button v-if="dialog.more" size="small" @@click="loadMoreTool">加载更多</i-button></div></div></div>
</div>
