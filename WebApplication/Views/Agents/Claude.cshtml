@{ ViewBag.Title = "Claude Code"; }
@section Styles {
    <link rel="stylesheet" href="~/css/claude.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/web-api.js" asp-append-version="true"></script>
    <script src="~/vendor/markdown-it/markdown-it.min.js" asp-append-version="true"></script>
    <script src="~/js/claude-content.js" asp-append-version="true"></script>
    <script src="~/js/claude.js" asp-append-version="true"></script>
}
<div id="claude-app" v-cloak class="claude-workspace">
    <aside class="claude-sessions" aria-label="Claude 会话">
        <header><h1>Claude Code</h1><button type="button" @@click="refresh" :disabled="refreshing">刷新</button><button type="button" @@click="creating=true">新建</button></header>
        <p class="claude-hint">{{setup.message || '检查本机官方 Claude Code…'}}</p>
        <p v-if="error" role="alert" class="claude-error">{{error}}</p>
        <button v-for="row in sessions" :key="row.id" type="button" class="claude-session" :class="{selected:selected?.id===row.id}" @@click="select(row)"><strong>{{row.title}}</strong><small>{{row.cwd}}</small><small>{{row.managed?'RemoteTool 会话':'本机会话 · 只读'}}</small></button>
        <p v-if="!sessions.length && !refreshing">暂无会话。新建时选择本机项目目录。</p>
    </aside>
    <section class="claude-chat" aria-label="Claude 聊天">
        <header><button class="mobile-finish-input" type="button" @@click="$el.querySelector('.claude-composer textarea')?.blur()">完成</button><button v-if="selected" class="claude-back" type="button" @@click="selected=null;epoch++">会话列表</button><div><h2>{{selected?.title || '选择或新建 Claude 会话'}}</h2><small>{{selected?.cwd}}</small></div><span>{{statusText}}</span><button v-if="running" type="button" @@click="stop" :disabled="acting">停止任务</button></header>
        <p v-if="selected && !selected.managed" class="claude-hint">电脑已有会话目前只读；在 RemoteTool 新建会话即可远程执行。</p>
        <p v-if="error" role="alert" class="claude-error">{{error}}</p>
        <div class="claude-history" aria-live="polite">
            <button v-if="earlierCount" type="button" class="claude-earlier" @@click="loadEarlier">显示更早的内容（还有 {{earlierCount}} 条）</button>
            <article v-for="m in historyRows" :key="m.id" class="claude-message" :class="{'claude-tool-row':m.toolOnly,'claude-user-message':m.role==='user'}">
                <small v-if="!m.toolOnly">{{m.role==='user'?'你':m.role==='assistant'?'Claude':'系统'}}</small>
                <details v-if="m.toolOnly && m.parts.length>1" class="claude-tool-group" :open="!!expanded['group:'+m.id]" @@toggle="togglePart('group:'+m.id,$event)"><summary>{{toolGroup(m)}}</summary><div v-if="expanded['group:'+m.id]">
                    <details v-for="tool in m.parts" :key="tool.key" class="claude-tool" :open="!!expanded[tool.key]" @@toggle="togglePart(tool.key,$event)"><summary><span>{{tool.name}}</span><span class="claude-tool-target">{{toolSummary(tool)}}</span><span class="claude-tool-state" :class="{error:tool.error}">{{tool.error?'错误':tool.complete?'完成':'等待结果'}}</span></summary><pre v-if="expanded[tool.key]">{{toolDetails(tool)}}</pre></details>
                </div></details>
                <template v-else v-for="part in m.parts" :key="part.key">
                    <details v-if="part.kind==='tool'" class="claude-tool" :open="!!expanded[part.key]" @@toggle="togglePart(part.key,$event)"><summary><span>{{part.name}}</span><span class="claude-tool-target">{{toolSummary(part)}}</span><span class="claude-tool-state" :class="{error:part.error}">{{part.error?'错误':part.complete?'完成':'等待结果'}}</span></summary><pre v-if="expanded[part.key]">{{toolDetails(part)}}</pre></details>
                    <details v-else-if="part.kind==='text' && part.long" class="claude-long-message" :open="!!expanded[part.key]" @@toggle="togglePart(part.key,$event)"><summary>{{part.text.slice(0,100)}}… · 展开完整内容</summary><div v-if="expanded[part.key]" class="claude-markdown" v-html="markdown(part.text)"></div></details>
                    <div v-else-if="part.kind==='text'" class="claude-markdown" v-html="markdown(part.text)"></div>
                    <p v-else class="claude-hint">{{part.text}}</p>
                </template>
            </article>
            <section v-if="events.length" class="claude-live"><h3>当前任务</h3><article v-for="m in liveMessages" :key="m.id" class="claude-message" :class="{'claude-tool-row':m.toolOnly,'claude-user-message':m.role==='user'}">
                <small v-if="!m.toolOnly">{{m.role==='user'?'你':m.role==='assistant'?'Claude':'系统'}}</small>
                <details v-if="m.toolOnly && m.parts.length>1" class="claude-tool-group" :open="!!expanded['group:'+m.id]" @@toggle="togglePart('group:'+m.id,$event)"><summary>{{toolGroup(m)}}</summary><div v-if="expanded['group:'+m.id]">
                    <details v-for="tool in m.parts" :key="tool.key" class="claude-tool" :open="!!expanded[tool.key]" @@toggle="togglePart(tool.key,$event)"><summary><span>{{tool.name}}</span><span class="claude-tool-target">{{toolSummary(tool)}}</span><span class="claude-tool-state" :class="{error:tool.error}">{{tool.error?'错误':tool.complete?'完成':'等待结果'}}</span></summary><pre v-if="expanded[tool.key]">{{toolDetails(tool)}}</pre></details>
                </div></details>
                <template v-else v-for="part in m.parts" :key="part.key">
                    <details v-if="part.kind==='tool'" class="claude-tool" :open="!!expanded[part.key]" @@toggle="togglePart(part.key,$event)"><summary><span>{{part.name}}</span><span class="claude-tool-target">{{toolSummary(part)}}</span><span class="claude-tool-state" :class="{error:part.error}">{{part.error?'错误':part.complete?'完成':'等待结果'}}</span></summary><pre v-if="expanded[part.key]">{{toolDetails(part)}}</pre></details>
                    <details v-else-if="part.kind==='text' && part.long" class="claude-long-message" :open="!!expanded[part.key]" @@toggle="togglePart(part.key,$event)"><summary>{{part.text.slice(0,100)}}… · 展开完整内容</summary><div v-if="expanded[part.key]" class="claude-markdown" v-html="markdown(part.text)"></div></details>
                    <div v-else-if="part.kind==='text'" class="claude-markdown" v-html="markdown(part.text)"></div>
                    <p v-else class="claude-hint">{{part.text}}</p>
                </template>
            </article><div v-if="streamText" class="claude-markdown" v-html="markdown(streamText)"></div></section>
            <p v-if="run?.error" role="status" class="claude-error">{{run.error}}</p>
            <p v-if="run?.usage">本轮输入 {{run.usage.tokens?.input_tokens ?? '—'}} · 输出 {{run.usage.tokens?.output_tokens ?? '—'}} Token · 参考费用 ${{run.usage.cost_usd ?? '—'}}</p>
        </div>
        <section v-if="request" class="claude-request" aria-label="Claude 等待确认">
            <h3>{{request.tool==='AskUserQuestion'?'Claude 需要你的回答':'工具授权 · '+request.tool}}</h3>
            <template v-if="request.tool==='AskUserQuestion'"><div v-for="q in request.input.questions" :key="q.question"><label>{{q.question}}<input v-model="answers[q.question]" :placeholder="q.multiSelect?'可填写多个选择或自己的答案':'选择或填写答案'" /></label><button v-for="option in q.options" :key="option.label" type="button" @@click="chooseAnswer(q,option.label)">{{option.label}}</button></div></template>
            <pre v-else>{{JSON.stringify(request.input,null,2)}}</pre>
            <button type="button" @@click="reply(true)" :disabled="acting">{{request.tool==='AskUserQuestion'?'提交回答':'允许本次'}}</button><button type="button" @@click="reply(false)" :disabled="acting">拒绝</button>
        </section>
        <form v-if="selected?.managed" class="claude-composer agent-compose-input-row" v-on:submit.prevent="send">
            <p v-if="pending">发送结果待核对。<button type="button" @@click="checkReceipt" :disabled="sending">核对发送回执</button></p>
            <label class="claude-hint">权限：{{selected.permission_mode}} · 按本机项目配置执行</label>
            <textarea v-model="draft" aria-label="发送给 Claude" placeholder="向 Claude 发送消息" rows="2" :disabled="!!pending" @@keydown.ctrl.enter.prevent="send"></textarea>
            <button type="submit" :disabled="!draft.trim() || loadingSession || running || sending || !!pending || !setup.ready || run?.status==='acceptance_unknown'">发送</button>
        </form>
    </section>
    <div v-if="creating" class="claude-modal" role="dialog" aria-modal="true" aria-label="新建 Claude 会话"><form v-on:submit.prevent="create"><h2>新建 Claude Code 会话</h2><label>标题<input v-model="newTitle" maxlength="200" /></label><label>本机项目绝对路径<input v-model="newCwd" required placeholder="/path/to/project 或 C:\project" /></label><label>权限<select v-model="newPermission"><option value="default">按本机规则询问</option><option value="acceptEdits">自动批准文件编辑</option><option value="plan">计划模式</option></select></label><p v-if="createError" role="alert">{{createError}}</p><button type="submit" :disabled="sending">创建</button><button type="button" :disabled="sending" @@click="creating=false">取消</button></form></div>
</div>
